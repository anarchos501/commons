# Don't abort when the running pnpm version differs from the pinned `packageManager`
# field. `turbo dev` spawns a nested `pnpm run dev` whose resolved pnpm version can
# drift (the devcontainer base image ships a newer pnpm; self-management is bypassed
# under corepack), which otherwise fails the package-manager-strict guard. The lockfile
# is still honored. The devcontainer Dockerfile pins pnpm@10.33.4 as the cleaner fix.
package-manager-strict=false

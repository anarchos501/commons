# Commons production environment
# Copy this file to apps/web/.env.production and fill in every value.
# Never commit .env.production — it contains real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# These are used directly by docker-compose.prod.yml.
# Generate a strong URL-safe password with: openssl rand -hex 32
POSTGRES_USER=commons
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=commons_prod

# ── Application secrets ───────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# Use a different value for each secret.
SESSION_SECRET=
FEEDBACK_FINGERPRINT_SECRET=

# ── App metadata ──────────────────────────────────────────────────────────
COMMONS_APP_VERSION=0.1.0

# ── GitHub feedback export (optional) ────────────────────────────────────
# Leave both blank to disable GitHub feedback integration.
# If enabled, the token needs only the "issues: write" scope on the target repo.
GITHUB_FEEDBACK_REPO=
GITHUB_FEEDBACK_TOKEN=

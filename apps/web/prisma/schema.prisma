generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Node {
  id                        String   @id @default(cuid())
  name                      String
  domain                    String   @unique
  constitutionalPreferences Json?
  federationPolicy          String   @default("disabled")
  pluginPolicy              String   @default("disabled")
  createdAt                 DateTime @default(now())

  accounts Account[]
  groups   Group[]
}

model PortableIdentity {
  id        String   @id @default(cuid())
  did       String   @unique
  publicKey String
  createdAt DateTime @default(now())

  accounts Account[]
}

model Account {
  id                 String   @id @default(cuid())
  portableIdentityId String?
  homeNodeId         String
  displayName        String
  accountType        String   @default("guest")
  publicKey          String?
  profileVisibility  String   @default("private")
  createdAt          DateTime @default(now())

  portableIdentity PortableIdentity? @relation(fields: [portableIdentityId], references: [id])
  homeNode         Node              @relation(fields: [homeNodeId], references: [id])

  serviceCapabilities ServiceCapability[]
  supportRequests     SupportRequest[]
  offers              Offer[]
  contributions       Contribution[]
  proposals           Proposal[]
  roles               Role[]

  @@index([homeNodeId])
  @@index([portableIdentityId])
}

model Group {
  id                    String   @id @default(cuid())
  nodeId                String
  name                  String
  description           String?
  membershipPolicy      String   @default("open")
  governancePreferences Json?
  privacyPreferences    Json?
  createdAt             DateTime @default(now())

  node            Node                       @relation(fields: [nodeId], references: [id])
  projects        Project[]
  trustApprovals  TrustedServiceCapability[]
  supportRequests SupportRequest[]
  offers          Offer[]
  contributions   Contribution[]
  proposals       Proposal[]
  roles           Role[]

  @@index([nodeId])
}

model Project {
  id                    String   @id @default(cuid())
  groupId               String
  name                  String
  description           String?
  status                String   @default("active")
  governancePreferences Json?
  privacyPreferences    Json?
  createdAt             DateTime @default(now())

  group           Group            @relation(fields: [groupId], references: [id])
  supportRequests SupportRequest[]
  offers          Offer[]
  contributions   Contribution[]
  proposals       Proposal[]
  roles           Role[]

  @@index([groupId])
}

model ServiceCapability {
  id               String   @id @default(cuid())
  accountId        String
  serviceType      String
  description      String?
  availability     Json?
  visibility       String   @default("group")
  trustRequirement String   @default("lightweight")
  approvalStatus   String   @default("available")
  createdAt        DateTime @default(now())

  account        Account                    @relation(fields: [accountId], references: [id])
  trustedRecords TrustedServiceCapability[]

  @@index([accountId])
  @@index([serviceType])
  @@index([approvalStatus])
}

model TrustedServiceCapability {
  id                  String    @id @default(cuid())
  serviceCapabilityId String
  groupId             String
  trustContext        String
  status              String    @default("petitioned")
  supportThreshold    Float?
  reviewEndsAt        DateTime?
  approvedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  serviceCapability ServiceCapability @relation(fields: [serviceCapabilityId], references: [id])
  group             Group             @relation(fields: [groupId], references: [id])

  @@index([serviceCapabilityId])
  @@index([groupId])
  @@index([status])
}

model SupportRequest {
  id                   String    @id @default(cuid())
  submittedByAccountId String?
  groupId              String
  projectId            String?
  requestType          String
  requestedServices    Json
  description          String
  urgency              String    @default("normal")
  privacyLevel         String    @default("private")
  status               String    @default("open")
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())

  submittedBy Account? @relation(fields: [submittedByAccountId], references: [id])
  group       Group    @relation(fields: [groupId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  offers      Offer[]

  @@index([submittedByAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([status])
  @@index([expiresAt])
}

model Offer {
  id               String    @id @default(cuid())
  accountId        String
  groupId          String
  projectId        String?
  supportRequestId String?
  offeredServices  Json
  description      String?
  availability     Json?
  status           String    @default("open")
  privacyLevel     String    @default("group")
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  account        Account         @relation(fields: [accountId], references: [id])
  group          Group           @relation(fields: [groupId], references: [id])
  project        Project?        @relation(fields: [projectId], references: [id])
  supportRequest SupportRequest? @relation(fields: [supportRequestId], references: [id])

  @@index([accountId])
  @@index([groupId])
  @@index([projectId])
  @@index([supportRequestId])
  @@index([status])
}

model Contribution {
  id                   String   @id @default(cuid())
  contributorAccountId String
  groupId              String?
  projectId            String?
  contributionType     String
  description          String
  quantity             String?
  occurredAt           DateTime
  visibility           String   @default("group")
  privacyEnvelope      Json?
  createdAt            DateTime @default(now())

  contributor Account  @relation(fields: [contributorAccountId], references: [id])
  group       Group?   @relation(fields: [groupId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])

  @@index([contributorAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([occurredAt])
}

model Proposal {
  id                            String    @id @default(cuid())
  groupId                       String
  projectId                     String?
  title                         String
  body                          String
  status                        String    @default("open")
  governancePreferencesSnapshot Json?
  createdByAccountId            String
  createdAt                     DateTime  @default(now())
  resolvedAt                    DateTime?

  group     Group    @relation(fields: [groupId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
  createdBy Account  @relation(fields: [createdByAccountId], references: [id])

  @@index([groupId])
  @@index([projectId])
  @@index([createdByAccountId])
  @@index([status])
}

model Role {
  id           String   @id @default(cuid())
  accountId    String
  roleType     String
  permissions  Json
  groupId      String?
  projectId    String?
  startsAt     DateTime @default(now())
  expiresAt    DateTime
  recallPolicy String   @default("proposal")
  createdAt    DateTime @default(now())

  account Account  @relation(fields: [accountId], references: [id])
  group   Group?   @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([accountId])
  @@index([groupId])
  @@index([projectId])
  @@index([expiresAt])
}

model GovernancePreference {
  id         String   @id @default(cuid())
  key        String
  value      Json
  scope      String
  scopeId    String?
  changeRule String   @default("mutable")
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([scope, scopeId])
  @@index([key])
}

model PrivacyEnvelope {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  level      String   @default("private")
  rules      Json?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([targetType, targetId])
  @@index([level])
}

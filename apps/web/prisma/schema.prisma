generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  guest
  participant
  member
}

enum VisibilityLevel {
  private
  group
  project
  public
}

enum PrivacyLevel {
  private
  group
  project
  public
}

enum GroupVisibility {
  private
  public
}

enum FederationPolicy {
  open
  allowlisted
  project_level
  read_only
  emergency_only
  disabled
}

enum PluginPolicy {
  open
  allowlisted
  reviewed
  disabled
}

enum ProjectStatus {
  active    // at least one active project member
  quiet     // no active members; at least one quiet member remains
  dormant   // no active or quiet members remain — independent of hosting (RFC-007: see ProjectHosting/pendingClosureAt for the separate, derived hosting axis)
  completed // mission intentionally fulfilled by project members; a one-way exit — never enters pending closure, never becomes closed (RFC-007)
  closed    // automatic: pending-closure grace period (30 days) elapsed with no mutually-approved successor host (RFC-007 amends this trigger; previously "no members AND no host groups")
}

enum TrustRequirement {
  lightweight
  elevated
}

enum ServiceCapabilityStatus {
  available
  petitioned
  approved
  revoked
  unavailable
}

enum TrustStatus {
  petitioned
  approved
  objected
  revoked
  expired
}

enum UrgencyLevel {
  low
  normal
  high
  urgent
}

enum SupportRequestStatus {
  open
  routed
  matched
  fulfilled
  expired
  deleted
}

enum OfferStatus {
  open
  accepted
  declined
  withdrawn
  expired
}

enum ProposalStatus {
  draft
  open
  approved
  rejected
  withdrawn
  implemented
}

enum AssignmentEndReason {
  expired
  quiet
  dormant
  recall
  resigned
}

enum CoordinationAbility {
  // Communication — D3 implements the models; abilities recorded now
  create_bulletins
  create_publications
  create_publication_entries
  // Coordination
  create_projects
  issue_support_requests
  issue_contribution_offers
  approve_membership
  // Contribution Categories — RFC: Contribution Categories & Trusted Provider Status
  create_contribution_categories
  // Accountability — in enum for completeness; NOT wired into platform behavior in D2.
  // Reviewer checks continue using hasActiveEligibleAssignment (see concerns.ts).
  review_concerns
  issue_findings
  issue_action_proposals
  administrative_closure
}

enum OfferingEntityType {
  group
  project
  responsibility
}

enum CategoryStatus {
  active
  archived
}

enum TrustedProviderStatusValue {
  active
  revoked
}

enum AbilityAvailability {
  always_available
  available_during_emergency // activation mechanics deferred to Governance RFC
}

enum CoordinationSpaceType {
  group
  project
  responsibility
  coalition
}

enum GovernanceScope {
  node
  group
  project
  coalition
  proposal
  service
  plugin
  contribution
  account
  trust
}

enum GovernanceChangeRule {
  mutable
  immutable
  stricter_only
  more_open_only
}

enum LinkedPresenceStatus {
  active
  migrating
  inactive
  revoked
}

enum SignedEventType {
  proposal_created
  support_request_submitted
  contribution_logged
  identity_presence_updated
  governance_preference_changed
  migration_prepared
}

enum DataClass {
  offline_draft
  personal_note
  local_reminder
  private_availability
  cached_coordination_history
  sync_queue_item
  support_request
  offer
  contribution
  proposal
  governance_preference
  portable_identity
  linked_node_presence
}

enum NodeStoragePolicy {
  none
  temporary
  canonical
  reference
}

enum LocalStoragePolicy {
  none
  cache
  draft
  private_data
  sync_queue
}

enum RequestRouteStatus {
  notified
  accepted
  declined
  expired
  cancelled
}

enum MembershipStatus {
  active
  pending
  inactive
  revoked
}

enum ParticipationStatus {
  active
  quiet
  dormant
}

enum ReportStatus {
  open
  under_review
  findings_issued
  action_proposed
  closed
  // Legacy values preserved for backward compatibility
  resolved
  dismissed
}

enum ConcernFindingOutcome {
  substantiated
  partially_substantiated
  unsubstantiated
  insufficient_information
  withdrawn
}

enum ConcernClosureReason {
  reporter_withdrawal
  review_complete_no_action
  action_accepted_and_implemented
  action_rejected_no_further_proposal
  administrative_closure
}

enum ConcernProposalStatus {
  pending
  accepted
  rejected
  superseded
}

enum ContentCreationType {
  bulletin
  publication
  publication_entry
  living_document
}

model Node {
  id                        String           @id @default(cuid())
  name                      String
  domain                    String           @unique
  stewardGroupId            String?
  stewardRevision           Int              @default(0)
  constitutionalPreferences Json?
  federationPolicy          FederationPolicy @default(disabled)
  pluginPolicy              PluginPolicy     @default(disabled)
  createdAt                 DateTime         @default(now())

  stewardGroup         Group?                 @relation("NodeStewardGroup", fields: [stewardGroupId], references: [id], onDelete: SetNull)
  accounts            Account[]
  groups              Group[]
  coalitions          Coalition[]
  hosts               NodeHost[]
  governanceSignals   NodeGovernanceSignal[]
  petitionSupport     NodePetitionSupport[]
  stewardProposals    NodeStewardProposal[]
  actionLogs          ActionLog[]
  linkedNodePresences LinkedNodePresence[]
  signedEvents        SignedEvent[]

  @@index([stewardGroupId])
}

model PortableIdentity {
  id        String   @id @default(cuid())
  did       String   @unique
  publicKey String
  createdAt DateTime @default(now())

  accounts            Account[]
  linkedNodePresences LinkedNodePresence[]
  signedEvents        SignedEvent[]
}

model LinkedNodePresence {
  id                 String               @id @default(cuid())
  portableIdentityId String
  nodeId             String
  handle             String
  status             LinkedPresenceStatus @default(active)
  createdAt          DateTime             @default(now())
  lastSeenAt         DateTime?

  portableIdentity PortableIdentity @relation(fields: [portableIdentityId], references: [id])
  node             Node             @relation(fields: [nodeId], references: [id])

  @@unique([portableIdentityId, nodeId])
  @@index([nodeId])
  @@index([status])
}

model Account {
  id                 String          @id @default(cuid())
  portableIdentityId String?
  homeNodeId         String
  displayName        String
  email              String?         @unique
  passwordHash       String?
  accountType        AccountType     @default(guest)
  publicKey          String?
  profileVisibility  VisibilityLevel @default(private)
  createdAt          DateTime        @default(now())

  portableIdentity PortableIdentity? @relation(fields: [portableIdentityId], references: [id])
  homeNode         Node              @relation(fields: [homeNodeId], references: [id])

  serviceCapabilities       ServiceCapability[]
  supportRequests           SupportRequest[]
  offers                    Offer[]
  contributions             Contribution[]
  proposals                 Proposal[]
  actionLogs                ActionLog[]
  signedEvents        SignedEvent[]
  localSyncStates     LocalSyncState[]
  requestRoutes       RequestRoute[]
  availability        ContributorAvailability[]
  groupMemberships    GroupMembership[]
  projectMemberships  ProjectMembership[]
  reportsSubmitted        Report[]
  concernReviews          ConcernReview[]
  concernFindings         ConcernFinding[]
  concernProposals        ConcernActionProposal[]
  bulletins               Bulletin[]
  publicationsCreated     Publication[]
  publicationEntries      PublicationEntry[]
  livingDocumentRevisions LivingDocumentRevision[]
  discussionThreadsCreated DiscussionThread[]
  discussionMessages       DiscussionMessage[]
  nodeHostRecords          NodeHost[]
  nodeGovernanceSignals    NodeGovernanceSignal[]
  nodePetitionSupport      NodePetitionSupport[]
  nodeStewardProposals     NodeStewardProposal[]
  createdNodePetitions     Petition[] @relation("PetitionAccountCreator")

  @@index([homeNodeId])
  @@index([portableIdentityId])
  @@index([accountType])
}

model Group {
  id                    String   @id @default(cuid())
  nodeId                String
  name                  String
  description           String?
  membershipPolicy      String          @default("open")
  visibility            GroupVisibility @default(private)
  governancePreferences Json?
  privacyPreferences    Json?
  createdAt             DateTime @default(now())

  node             Node                       @relation(fields: [nodeId], references: [id])
  foundedProjects  Project[]
  hostedProjects   ProjectHosting[]
  hostingProposals ProjectHostingProposal[]
  coalitionMemberships CoalitionMembership[]
  coalitionProposalsSponsored CoalitionProposal[] @relation("CoalitionProposalSponsor")
  coalitionProposalPetitions CoalitionProposalPetition[]
  stewardForNodes            Node[] @relation("NodeStewardGroup")
  nodeStewardCandidates      NodeStewardProposal[] @relation("NodeStewardCandidate")
  nodeStewardInitiations     NodeStewardProposal[] @relation("NodeStewardInitiatingGroup")
  trustApprovals   TrustedServiceCapability[]
  supportRequests  SupportRequest[]
  offers           Offer[]
  contributions    Contribution[]
  proposals        Proposal[]
  responsibilities Responsibility[]
  actionLogs       ActionLog[]
  signedEvents     SignedEvent[]
  serviceOfferings GroupServiceOffering[]
  memberships        GroupMembership[]
  reports            Report[]
  concernReviews     ConcernReview[]
  concernFindings    ConcernFinding[]
  concernProposals   ConcernActionProposal[]
  governanceSignals              MemberGovernanceSignal[]
  petitions                      Petition[]
  emergencyPeriods               EmergencyPeriod[]
  contributionCategories         ContributionCategory[]
  contributionCategoryDrafts     ContributionCategoryDraft[]
  trustedProviderApplications    TrustedProviderApplication[]
  trustedProviderRevocations     TrustedProviderRevocationRequest[]
  trustedProviderStatuses        TrustedProviderStatus[]
  inviteTokens                   GroupInviteToken[]
  contentCreationDrafts          ContentCreationDraft[]
  responsibilityProposalDrafts   ResponsibilityProposalDraft[]

  @@unique([nodeId, name])
  @@index([nodeId])
}

model NodeHost {
  id        String    @id @default(cuid())
  nodeId    String
  accountId String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  node    Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([accountId])
  @@index([revokedAt])
}

model NodeGovernanceSignal {
  id        String   @id @default(cuid())
  nodeId    String
  accountId String
  category  String
  parameter String   @default("_")
  signal    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  node    Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, nodeId, category, parameter])
  @@index([nodeId, category])
}

model NodeStewardProposal {
  id                        String    @id @default(cuid())
  nodeId                    String
  action                    String    // appointment | no_confidence | resignation
  origin                    String    // host | group
  candidateGroupId          String
  initiatingGroupId         String?
  initiatedByAccountId      String?
  baselineStewardGroupId    String?
  baselineStewardRevision   Int
  groupInitiationPetitionId String?   @unique
  candidateConsentPetitionId String?  @unique
  nodePetitionId            String?   @unique
  status                    String    @default("open") // open | awaiting_candidate_consent | awaiting_node_vote | succeeded | failed-rejected | failed-withdrawn | failed-stale
  snapshot                  Json
  createdAt                 DateTime  @default(now())
  resolvedAt                DateTime?

  node            Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  candidateGroup  Group    @relation("NodeStewardCandidate", fields: [candidateGroupId], references: [id])
  initiatingGroup Group?   @relation("NodeStewardInitiatingGroup", fields: [initiatingGroupId], references: [id])
  initiatedBy     Account? @relation(fields: [initiatedByAccountId], references: [id], onDelete: SetNull)

  @@index([nodeId, status])
  @@index([candidateGroupId])
  @@index([initiatingGroupId])
  @@index([initiatedByAccountId])
}

model Coalition {
  id          String    @id @default(cuid())
  nodeId      String
  name        String
  description String?
  status      String    @default("active") // active | dissolved
  createdAt   DateTime  @default(now())
  dissolvedAt DateTime?

  node        Node                  @relation(fields: [nodeId], references: [id])
  memberships CoalitionMembership[]
  proposals   CoalitionProposal[]

  @@unique([nodeId, name])
  @@index([nodeId])
  @@index([status])
}

model CoalitionMembership {
  id          String    @id @default(cuid())
  coalitionId String
  groupId     String
  joinedAt    DateTime  @default(now())
  endedAt     DateTime?
  endReason   String?

  coalition Coalition @relation(fields: [coalitionId], references: [id])
  group     Group     @relation(fields: [groupId], references: [id])

  @@index([coalitionId])
  @@index([groupId])
  @@index([endedAt])
}

model CoalitionProposal {
  id                  String    @id @default(cuid())
  coalitionId         String?
  action              String    // formation | join | departure | removal
  proposedByGroupId   String
  targetGroupId       String?
  name                String?
  description         String?
  content             String
  participantSnapshot Json
  status              String    @default("open") // open | succeeded | failed-rejected | failed-withdrawn | failed-timeout
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  coalition       Coalition?                  @relation(fields: [coalitionId], references: [id])
  proposedByGroup Group                       @relation("CoalitionProposalSponsor", fields: [proposedByGroupId], references: [id])
  petitions       CoalitionProposalPetition[]

  @@index([coalitionId])
  @@index([proposedByGroupId])
  @@index([targetGroupId])
  @@index([action])
  @@index([status])
}

model CoalitionProposalPetition {
  id            String   @id @default(cuid())
  proposalId    String
  groupId       String
  petitionId    String   @unique
  role          String   // participant | applicant | departing | remaining_member
  groupSnapshot Json
  createdAt     DateTime @default(now())

  proposal CoalitionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  group    Group             @relation(fields: [groupId], references: [id])

  @@unique([proposalId, groupId])
  @@index([proposalId])
  @@index([groupId])
}

model GroupMembership {
  id                  String              @id @default(cuid())
  accountId           String
  groupId             String
  joinedAt            DateTime            @default(now())
  status              MembershipStatus    @default(active)
  participationStatus ParticipationStatus @default(active)
  lastSeenAt          DateTime?
  applicationNote     String?             // optional note submitted with a pending membership application

  account                       Account                            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  group                         Group                              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  responsibilityAssignments     ResponsibilityAssignment[]
  governanceSignals             MemberGovernanceSignal[]
  createdPetitions              Petition[]                         @relation("PetitionCreator")
  petitionSupport               PetitionSupport[]
  proposedCategoryDrafts        ContributionCategoryDraft[]
  responsibilityProposalDrafts  ResponsibilityProposalDraft[]
  trustedProviderApplications   TrustedProviderApplication[]
  trustedProviderRevocations    TrustedProviderRevocationRequest[]
  trustedProviderStatuses       TrustedProviderStatus[]
  createdInviteTokens           GroupInviteToken[]

  @@unique([accountId, groupId])
  @@index([accountId])
  @@index([groupId])
  @@index([groupId, participationStatus])
}

model GroupServiceOffering {
  id                      String   @id @default(cuid())
  groupId                 String
  serviceType             String
  status                  String   @default("active")
  minimumContributorTrust String   @default("lightweight")
  projectId               String?
  createdAt               DateTime @default(now())

  group   Group    @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([groupId, serviceType])
  @@index([groupId])
  @@index([status])
  @@index([projectId])
}

model GroupInviteToken {
  id                    String    @id @default(cuid())
  tokenHash             String    @unique   // SHA-256 of raw token; raw token is never stored
  tokenPreview          String              // first 8 chars of raw token for display after reload
  groupId               String
  createdByMembershipId String
  createdAt             DateTime  @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?

  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy GroupMembership @relation(fields: [createdByMembershipId], references: [id])

  @@index([groupId])
}

model Project {
  id                    String        @id @default(cuid())
  foundingGroupId       String        // immutable founding-group provenance; confers no current-hosting authority (see ProjectHosting)
  name                  String
  description           String?
  status                ProjectStatus @default(active)
  membershipPolicy      String        @default("petition") // petition = requires approval workflow
  governancePreferences Json?
  privacyPreferences    Json?
  archivedAt            DateTime?     // visibility flag: archived ≠ closed/completed
  pendingClosureAt      DateTime?     // set when the last active ProjectHosting ends; opens the 30-day adoption grace period (RFC-007)
  pendingClosureElectorate Json?       // immutable ProjectMembership/account snapshot captured with pendingClosureAt
  // Future: archivedBy, archiveProposalId, archiveReason (Governance RFC)
  createdAt             DateTime      @default(now())

  foundingGroup    Group                  @relation(fields: [foundingGroupId], references: [id])
  hostings         ProjectHosting[]
  hostingProposals ProjectHostingProposal[]
  memberships      ProjectMembership[]
  serviceOfferings GroupServiceOffering[]
  supportRequests  SupportRequest[]
  offers           Offer[]
  contributions    Contribution[]
  proposals        Proposal[]
  actionLogs       ActionLog[]
  signedEvents     SignedEvent[]

  @@unique([foundingGroupId, name])
  @@index([foundingGroupId])
  @@index([status])
  @@index([archivedAt])
}

model ProjectHosting {
  id        String    @id @default(cuid())
  projectId String
  groupId   String
  hostedAt  DateTime  @default(now())
  endedAt   DateTime? // null = active hosting; set on withdrawal. Active uniqueness on [projectId, groupId] is enforced by a partial index in migration SQL (Prisma cannot express WHERE-conditioned @@unique)

  project Project @relation(fields: [projectId], references: [id])
  group   Group   @relation(fields: [groupId], references: [id])

  @@index([projectId])
  @@index([groupId])
  @@index([endedAt])
}

model ProjectMembership {
  id                  String              @id @default(cuid())
  accountId           String
  projectId           String
  joinedAt            DateTime            @default(now())
  status              MembershipStatus    @default(active)
  participationStatus ParticipationStatus @default(active)
  lastSeenAt          DateTime?

  account          Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdPetitions Petition[]       @relation("PetitionProjectCreator")
  petitionSupport  PetitionSupport[] @relation("PetitionSupportProject")
  contributionCategoryDrafts ContributionCategoryDraft[] @relation("ContributionCategoryDraftProjectProposer")

  @@unique([accountId, projectId])
  @@index([accountId])
  @@index([projectId])
  @@index([projectId, participationStatus])
}

// RFC-007: links a candidate group's "should we host?" petition with a pending-closure
// project's "should we accept this host?" petition into one mutual-consent bundle.
// Same orchestration shape as CoalitionProposal (Phase 2): immutable snapshots + frozen
// electorate + linked child petitions + resolution state. ProjectHosting is created only
// when both child petitions succeed; either side rejecting, withdrawing, or timing out
// fails the whole proposal and supersedes the other still-open petition.
model ProjectHostingProposal {
  id                     String    @id @default(cuid())
  projectId              String
  candidateGroupId       String
  projectSnapshot        Json      // immutable { id, name } project identity at proposal creation
  candidateGroupSnapshot Json      // immutable { id, name } candidate-group identity at proposal creation
  frozenElectorate       Json      // immutable array of qualifying ProjectMembership ids, captured at Project.pendingClosureAt (RFC-007 pending-closure electorate)
  content                String    // immutable rationale supplied when the proposal was opened
  groupPetitionId        String    @unique // candidate group's "should we host?" petition (Petition.id; loose reference, validated at service layer like Petition.subjectId)
  projectPetitionId      String    @unique // project's "should we accept this host?" petition (Petition.id; loose reference, validated at service layer like Petition.subjectId)
  status                 String    @default("open") // open | succeeded | failed-rejected | failed-withdrawn | failed-timeout
  createdAt              DateTime  @default(now())
  resolvedAt             DateTime?

  project        Project @relation(fields: [projectId], references: [id])
  candidateGroup Group   @relation(fields: [candidateGroupId], references: [id])

  @@index([projectId])
  @@index([candidateGroupId])
  @@index([groupPetitionId])
  @@index([projectPetitionId])
  @@index([status])
}

model ServiceCapability {
  id               String                  @id @default(cuid())
  accountId        String
  serviceType      String
  description      String?
  availability     Json?
  visibility       VisibilityLevel         @default(group)
  trustRequirement TrustRequirement        @default(lightweight)
  approvalStatus   ServiceCapabilityStatus @default(available)
  // Optional link to a community-governed ContributionCategory (RFC: Contribution Categories)
  categoryId       String?
  createdAt        DateTime                @default(now())

  account             Account                    @relation(fields: [accountId], references: [id])
  trustedRecords      TrustedServiceCapability[]
  requestRoutes       RequestRoute[]
  availabilityRecords ContributorAvailability[]
  category            ContributionCategory?      @relation(fields: [categoryId], references: [id])

  @@unique([accountId, serviceType, trustRequirement])
  @@index([accountId])
  @@index([serviceType])
  @@index([approvalStatus])
  @@index([trustRequirement])
  @@index([categoryId])
}

model TrustedServiceCapability {
  id                  String      @id @default(cuid())
  serviceCapabilityId String
  groupId             String
  trustContext        String
  status              TrustStatus @default(petitioned)
  approvedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime    @default(now())

  serviceCapability ServiceCapability @relation(fields: [serviceCapabilityId], references: [id])
  group             Group             @relation(fields: [groupId], references: [id])

  @@unique([serviceCapabilityId, groupId, trustContext])
  @@index([serviceCapabilityId])
  @@index([groupId])
  @@index([status])
}

model SupportRequest {
  id                   String               @id @default(cuid())
  submittedByAccountId String?
  guestRequestId       String?
  groupId              String
  projectId            String?
  requestType          String
  requestedServices    Json
  description          String
  urgency              UrgencyLevel         @default(normal)
  privacyLevel         PrivacyLevel         @default(private)
  status               SupportRequestStatus @default(open)
  expiresAt            DateTime?
  accountabilityEndsAt DateTime?
  createdAt            DateTime             @default(now())

  submittedBy       Account?                @relation(fields: [submittedByAccountId], references: [id])
  group             Group                   @relation(fields: [groupId], references: [id])
  project           Project?                @relation(fields: [projectId], references: [id])
  offers            Offer[]
  services          SupportRequestService[]
  routes            RequestRoute[]
  guestAccessToken  GuestAccessToken?

  @@index([submittedByAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([status])
  @@index([expiresAt])
  @@index([accountabilityEndsAt])
  @@index([urgency])
}

model GuestAccessToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  supportRequestId String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?

  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  reports        Report[]
}

model SupportRequestService {
  id               String           @id @default(cuid())
  supportRequestId String
  serviceType      String
  trustRequirement TrustRequirement @default(lightweight)
  // Optional link to a community-governed ContributionCategory (RFC: Contribution Categories)
  categoryId       String?
  createdAt        DateTime         @default(now())

  supportRequest SupportRequest        @relation(fields: [supportRequestId], references: [id])
  category       ContributionCategory? @relation(fields: [categoryId], references: [id])

  @@unique([supportRequestId, serviceType, trustRequirement])
  @@index([serviceType])
  @@index([trustRequirement])
  @@index([categoryId])
}

model RequestRoute {
  id                   String             @id @default(cuid())
  supportRequestId     String
  contributorAccountId String
  serviceCapabilityId  String?
  serviceType          String
  trustRequirement     TrustRequirement   @default(lightweight)
  status               RequestRouteStatus @default(notified)
  decisionNote         String?
  decidedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  supportRequest    SupportRequest    @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  contributor       Account           @relation(fields: [contributorAccountId], references: [id], onDelete: Cascade)
  serviceCapability ServiceCapability? @relation(fields: [serviceCapabilityId], references: [id], onDelete: Cascade)

  @@unique([supportRequestId, contributorAccountId, serviceType, trustRequirement])
  @@index([supportRequestId])
  @@index([contributorAccountId])
  @@index([serviceCapabilityId])
  @@index([serviceType])
  @@index([trustRequirement])
  @@index([status])
  @@index([createdAt])
}

model ContributorAvailability {
  id                  String   @id @default(cuid())
  accountId           String
  serviceCapabilityId String?
  serviceType         String
  availability        Json
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  serviceCapability ServiceCapability? @relation(fields: [serviceCapabilityId], references: [id], onDelete: Cascade)

  @@unique([accountId, serviceType])
  @@index([accountId])
  @@index([serviceCapabilityId])
  @@index([serviceType])
  @@index([active])
}

model Offer {
  id               String       @id @default(cuid())
  accountId        String
  groupId          String
  projectId        String?
  supportRequestId String?
  offeredServices  Json
  description      String?
  availability     Json?
  status           OfferStatus  @default(open)
  privacyLevel     PrivacyLevel @default(group)
  expiresAt        DateTime?
  createdAt        DateTime     @default(now())

  account        Account         @relation(fields: [accountId], references: [id])
  group          Group           @relation(fields: [groupId], references: [id])
  project        Project?        @relation(fields: [projectId], references: [id])
  supportRequest SupportRequest? @relation(fields: [supportRequestId], references: [id])
  services       OfferService[]

  @@index([accountId])
  @@index([groupId])
  @@index([projectId])
  @@index([supportRequestId])
  @@index([status])
  @@index([expiresAt])
}

model OfferService {
  id               String           @id @default(cuid())
  offerId          String
  serviceType      String
  trustRequirement TrustRequirement @default(lightweight)
  createdAt        DateTime         @default(now())

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([offerId, serviceType, trustRequirement])
  @@index([serviceType])
  @@index([trustRequirement])
}

model Contribution {
  id                   String          @id @default(cuid())
  contributorAccountId String
  groupId              String?
  projectId            String?
  contributionType     String
  description          String
  quantity             String?
  occurredAt           DateTime
  visibility           VisibilityLevel @default(group)
  privacyEnvelope      Json?
  createdAt            DateTime        @default(now())

  contributor Account  @relation(fields: [contributorAccountId], references: [id])
  group       Group?   @relation(fields: [groupId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])

  @@index([contributorAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([occurredAt])
  @@index([visibility])
}

model Proposal {
  id                            String         @id @default(cuid())
  groupId                       String
  projectId                     String?
  title                         String
  body                          String
  status                        ProposalStatus @default(open)
  governancePreferencesSnapshot Json?
  createdByAccountId            String
  createdAt                     DateTime       @default(now())
  resolvedAt                    DateTime?

  group     Group    @relation(fields: [groupId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
  createdBy Account  @relation(fields: [createdByAccountId], references: [id])

  @@index([groupId])
  @@index([projectId])
  @@index([createdByAccountId])
  @@index([status])
}

model Report {
  id                  String                @id @default(cuid())
  reportedByAccountId String?
  guestAccessTokenId  String?
  groupId             String
  subject             String
  context             String?
  description         String
  status              ReportStatus          @default(open)
  visibility          String                @default("private")
  closureReason       ConcernClosureReason?
  closedAt            DateTime?
  resolvedAt          DateTime?
  resolvedNote        String?
  createdAt           DateTime              @default(now())

  reportedBy       Account?               @relation(fields: [reportedByAccountId], references: [id])
  guestAccessToken GuestAccessToken?      @relation(fields: [guestAccessTokenId], references: [id])
  group            Group                  @relation(fields: [groupId], references: [id])
  reviews          ConcernReview[]
  findings         ConcernFinding[]
  actionProposals  ConcernActionProposal[]

  @@index([reportedByAccountId])
  @@index([guestAccessTokenId])
  @@index([groupId])
  @@index([status])
}

model ConcernReview {
  id          String    @id @default(cuid())
  reportId    String
  reviewerId  String
  groupId     String
  notes       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  report   Report  @relation(fields: [reportId], references: [id])
  reviewer Account @relation(fields: [reviewerId], references: [id])
  group    Group   @relation(fields: [groupId], references: [id])

  @@index([reportId])
  @@index([reviewerId])
  @@index([groupId])
}

model ConcernFinding {
  id         String                @id @default(cuid())
  reportId   String
  reviewerId String
  groupId    String
  outcome    ConcernFindingOutcome
  summary    String
  createdAt  DateTime              @default(now())

  report   Report  @relation(fields: [reportId], references: [id])
  reviewer Account @relation(fields: [reviewerId], references: [id])
  group    Group   @relation(fields: [groupId], references: [id])

  @@index([reportId])
  @@index([reviewerId])
}

model ConcernActionProposal {
  id             String                @id @default(cuid())
  reportId       String
  proposedById   String
  groupId        String
  proposedAction String
  rationale      String
  iteration      Int                   @default(1)
  // Governance Decision layer connects here — deferred to future governance RFC
  status         ConcernProposalStatus @default(pending)
  createdAt      DateTime              @default(now())

  report     Report  @relation(fields: [reportId], references: [id])
  proposedBy Account @relation(fields: [proposedById], references: [id])
  group      Group   @relation(fields: [groupId], references: [id])

  @@index([reportId])
  @@index([proposedById])
}

model Responsibility {
  // first-class built-in: "reviewer" (platform understands this type)
  // all other values are custom responsibility types created by group governance
  // Custom responsibilities are the expected long-term coordination mechanism;
  // reviewer is first-class only because the accountability system requires
  // platform-level reviewer behavior.
  id        String   @id @default(cuid())
  groupId   String
  type      String
  termDays  Int      @default(365)
  createdAt DateTime @default(now())
  // Polymorphic pointer to the LivingDocument (spaceType: "responsibility", spaceId: this.id,
  // title: "Purpose") that holds this role's editable purpose statement. Not FK-enforced —
  // mirrors the LivingDocument.spaceId convention (see living-documents.ts). Null until a
  // responsibility-creation proposal seeds one; pre-existing/seeded responsibilities stay null
  // until a member proposes a living document for the role through the normal flow.
  descriptionDocumentId String?

  group       Group                     @relation(fields: [groupId], references: [id])
  assignments ResponsibilityAssignment[]
  abilities   ResponsibilityAbility[]

  @@unique([groupId, type])
  @@index([groupId])
  @@index([type])
}

model ResponsibilityAssignment {
  id               String               @id @default(cuid())
  responsibilityId String
  // FK to GroupMembership — responsibilities are group-scoped, not account-scoped.
  // A member can be Active in Group A and Quiet in Group B simultaneously.
  membershipId     String
  startedAt        DateTime             @default(now())
  expiresAt        DateTime             // derived from Responsibility.termDays at assignment time
  endedAt          DateTime?
  endReason        AssignmentEndReason?
  createdAt        DateTime             @default(now())

  responsibility Responsibility  @relation(fields: [responsibilityId], references: [id])
  membership     GroupMembership @relation(fields: [membershipId], references: [id])

  @@index([responsibilityId])
  @@index([membershipId])
  @@index([expiresAt])
}

model ResponsibilityAbility {
  id               String              @id @default(cuid())
  responsibilityId String
  ability          CoordinationAbility
  availability     AbilityAvailability @default(always_available)
  createdAt        DateTime            @default(now())

  responsibility Responsibility @relation(fields: [responsibilityId], references: [id])

  @@unique([responsibilityId, ability])
  @@index([responsibilityId])
}

model ResponsibilityProposalDraft {
  id                      String    @id @default(cuid())
  groupId                 String
  type                    String
  description             String    // seed text for the responsibility's auto-created Purpose living document
  abilities               Json      // [{ ability: CoordinationAbility, availability: AbilityAvailability }]
  proposedByMembershipId  String
  createdAt               DateTime  @default(now())
  appliedAt               DateTime?
  appliedResponsibilityId String?   // the Responsibility this proposal resulted in or was merged into

  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [proposedByMembershipId], references: [id])

  @@index([groupId])
  @@index([proposedByMembershipId])
}

model GovernancePreference {
  id         String               @id @default(cuid())
  key        String
  value      Json
  scope      GovernanceScope
  scopeId    String?
  changeRule GovernanceChangeRule @default(mutable)
  createdBy  String
  createdAt  DateTime             @default(now())

  @@index([scope, scopeId])
  @@index([key])
}

// --- RFC-006: Governance Temperature ---

model MemberGovernanceSignal {
  id           String          @id @default(cuid())
  membershipId String
  groupId      String
  category     String          // GovernanceCategory key, validated at service layer
  parameter    String          @default("_") // "_" = category-level, otherwise a category parameter key
  signal       Int             // constrained to -1 | 0 | +1 at service layer
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([membershipId, category, parameter])
  @@index([groupId, category])
}

// --- RFC-006: Emergency Period ---

model EmergencyPeriod {
  id                 String    @id @default(cuid())
  groupId            String
  petitionId         String?   // null when created via declareTempStewardship (no petition)
  startedAt          DateTime  @default(now())
  expiresAt          DateTime
  endedAt            DateTime?
  endedByPetitionId  String?   // set if ended via deactivation petition

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([expiresAt])
}

// --- RFC-006: Petition Infrastructure ---

model Petition {
  id                           String    @id @default(cuid())
  // Scope fields (P1 migration): scopeType/scopeId replace groupId as the governing-entity reference.
  // groupId kept as nullable for backward compat during transition — prefer scopeId.
  groupId                      String?
  scopeType                    String    @default("group") // "group" | "project" | "responsibility" | "node"
  scopeId                      String    // governing entity id; backfilled from groupId for existing records
  category                     String    // GovernanceCategory, validated at service layer
  subjectType                  String    // ProposalFamily, validated at service layer
  subjectId                    String
  competitionKey               String?   // derived from subjectType+subjectId; null = non-competing
  status                       String    @default("open") // open | approved | rejected | withdrawn | superseded | blocked
  governanceSnapshot           Json      // resolved parameters frozen at petition open time
  // null = group-wide voting; { type: "project", scopeId } = project-member voting
  voterScope                   Json?
  opensAt                      DateTime  @default(now())
  closesAt                     DateTime
  resolvedAt                   DateTime?
  archivedAt                   DateTime? // set lazily ~30 days after resolvedAt by archiveStalePetitions
  createdByMembershipId        String?   // legacy: GroupMembership FK — kept for compat
  createdByProjectMembershipId String?   // new: ProjectMembership FK for project-scoped petitions
  createdByAccountId           String?   // account creator for node-host-origin petitions

  group             Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy         GroupMembership?   @relation("PetitionCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  createdByProject  ProjectMembership? @relation("PetitionProjectCreator", fields: [createdByProjectMembershipId], references: [id], onDelete: SetNull)
  createdByAccount  Account?           @relation("PetitionAccountCreator", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  support           PetitionSupport[]
  nodeSupport       NodePetitionSupport[]

  @@index([scopeType, scopeId, status])
  @@index([groupId, status])
  @@index([groupId, archivedAt])
  @@index([category])
  @@index([competitionKey])
  @@index([subjectType, subjectId])
}

model NodePetitionSupport {
  id         String   @id @default(cuid())
  petitionId String
  nodeId     String
  accountId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  petition Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  node     Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([petitionId, accountId])
  @@index([nodeId, accountId])
}

model PetitionSupport {
  id                  String   @id @default(cuid())
  petitionId          String
  // P1 migration: membershipId made nullable; projectMembershipId added.
  // Exactly one of membershipId/projectMembershipId must be non-null (service-layer enforced).
  // Partial unique indexes (in migration SQL, not Prisma-managed):
  //   UNIQUE (petitionId, membershipId) WHERE membershipId IS NOT NULL
  //   UNIQUE (petitionId, projectMembershipId) WHERE projectMembershipId IS NOT NULL
  membershipId        String?  // GroupMembership; nullable (was required)
  projectMembershipId String?  // ProjectMembership; null for group-scoped petitions
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  petition          Petition           @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  membership        GroupMembership?   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  projectMembership ProjectMembership? @relation("PetitionSupportProject", fields: [projectMembershipId], references: [id], onDelete: Cascade)

  @@index([petitionId])
}

model PrivacyEnvelope {
  id         String       @id @default(cuid())
  targetType String
  targetId   String
  level      PrivacyLevel @default(private)
  rules      Json?
  createdBy  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([targetType, targetId])
  @@index([level])
}

model ActionLog {
  id             String   @id @default(cuid())
  actorAccountId String?
  groupId        String?
  projectId      String?
  nodeId         String?
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor   Account? @relation(fields: [actorAccountId], references: [id])
  group   Group?   @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  node    Node?    @relation(fields: [nodeId], references: [id])

  @@index([actorAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([nodeId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SignedEvent {
  id                 String          @id @default(cuid())
  eventType          SignedEventType
  subjectType        String
  subjectId          String
  actorAccountId     String?
  portableIdentityId String?
  nodeId             String?
  groupId            String?
  projectId          String?
  payload            Json
  payloadHash        String
  signature          String
  publicKey          String
  createdAt          DateTime        @default(now())

  actor            Account?          @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  portableIdentity PortableIdentity? @relation(fields: [portableIdentityId], references: [id], onDelete: SetNull)
  node             Node?             @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  group            Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([payloadHash, signature])
  @@index([eventType])
  @@index([subjectType, subjectId])
  @@index([actorAccountId])
  @@index([portableIdentityId])
  @@index([nodeId])
  @@index([groupId])
  @@index([projectId])
  @@index([createdAt])
}

model LocalSyncState {
  id               String    @id @default(cuid())
  accountId        String
  deviceId         String
  lastAckedEventId String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceId])
  @@index([lastAckedEventId])
  @@index([lastSyncedAt])
}

model DataReplicationPolicy {
  id                  String             @id @default(cuid())
  scope               GovernanceScope
  scopeId             String
  dataClass           DataClass
  nodeStorage         NodeStoragePolicy
  localStorage        LocalStoragePolicy
  federationAllowed   Boolean            @default(false)
  p2pAllowed          Boolean            @default(false)
  retentionDays       Int?
  requiresEncryption  Boolean            @default(true)
  userExportAllowed   Boolean            @default(true)
  userDeletionAllowed Boolean            @default(true)
  syncRequiresConsent Boolean            @default(true)
  createdAt           DateTime           @default(now())

  @@unique([scope, scopeId, dataClass])
  @@index([dataClass])
  @@index([scope, scopeId])
  @@index([federationAllowed])
  @@index([p2pAllowed])
}

// --- D3: Communication Schema ---
// All communication models use { spaceType, spaceId } to target any Coordination Space
// (Group, Project, or Responsibility) without table-per-type duplication.

model Bulletin {
  id                String                @id @default(cuid())
  spaceType         CoordinationSpaceType
  spaceId           String
  authorId          String
  title             String
  body              String
  publishedAt       DateTime              @default(now())
  archivedAt        DateTime?
  archivedByAccountId String?
  archiveProposalId String?
  archiveReason     String?
  createdAt         DateTime              @default(now())

  author Account @relation(fields: [authorId], references: [id])

  @@index([spaceType, spaceId])
  @@index([authorId])
  @@index([archivedAt])
}

model Publication {
  id                  String                @id @default(cuid())
  spaceType           CoordinationSpaceType
  spaceId             String
  title               String
  createdByAccountId  String
  archivedAt          DateTime?
  archivedByAccountId String?
  archiveProposalId   String?
  archiveReason       String?
  createdAt           DateTime              @default(now())

  creator Account          @relation(fields: [createdByAccountId], references: [id])
  entries PublicationEntry[]

  @@index([spaceType, spaceId])
  @@index([createdByAccountId])
  @@index([archivedAt])
}

model PublicationEntry {
  id                  String    @id @default(cuid())
  publicationId       String
  authorId            String
  title               String?
  body                String
  publishedAt         DateTime  @default(now())
  archivedAt          DateTime?
  archivedByAccountId String?
  archiveProposalId   String?
  archiveReason       String?

  publication Publication @relation(fields: [publicationId], references: [id])
  author      Account     @relation(fields: [authorId], references: [id])

  @@index([publicationId])
  @@index([authorId])
  @@index([archivedAt])
}

model LivingDocument {
  id                  String                @id @default(cuid())
  spaceType           CoordinationSpaceType
  spaceId             String
  title               String
  currentBody         String
  // currentBody is always the current accepted version.
  // LivingDocument identity persists across revisions: revisions create
  // LivingDocumentRevision records, never a new LivingDocument.
  lastRevisedAt       DateTime              @default(now())
  archivedAt          DateTime?
  archivedByAccountId String?
  archiveProposalId   String?
  archiveReason       String?
  createdAt           DateTime              @default(now())

  revisions LivingDocumentRevision[]

  @@unique([spaceType, spaceId, title])
  @@index([spaceType, spaceId])
  @@index([archivedAt])
}

model LivingDocumentRevision {
  id                   String    @id @default(cuid())
  livingDocumentId     String
  authorId             String
  body                 String
  proposalId           String?   // FK to Petition.id (set on approval)
  approvedAt           DateTime?
  approvedByAccountId  String?
  createdAt            DateTime  @default(now())

  livingDocument LivingDocument @relation(fields: [livingDocumentId], references: [id])
  author         Account        @relation(fields: [authorId], references: [id])

  @@index([livingDocumentId])
  @@index([authorId])
}

model DiscussionThread {
  id                  String                @id @default(cuid())
  spaceType           CoordinationSpaceType
  spaceId             String
  title               String
  createdByAccountId  String
  lastActivityAt      DateTime              @default(now())
  messageCount        Int                   @default(0)
  closedAt            DateTime?
  closedByPetitionId  String?
  closureReason       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  creator  Account             @relation(fields: [createdByAccountId], references: [id])
  messages DiscussionMessage[]

  @@index([spaceType, spaceId])
  @@index([createdByAccountId])
  @@index([lastActivityAt])
  @@index([closedAt])
}

model DiscussionMessage {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author Account          @relation(fields: [authorId], references: [id])

  @@index([threadId])
  @@index([authorId])
  @@index([expiresAt])
  @@index([createdAt])
}

// --- RFC: Contribution Categories & Trusted Provider Status ---

model ContributionCategoryDraft {
  id                     String             @id @default(cuid())
  groupId                String
  offeringEntityType     OfferingEntityType
  offeringEntityId       String
  name                   String
  description            String
  proposedByMembershipId String?
  proposedByProjectMembershipId String?
  createdAt              DateTime           @default(now())

  group             Group              @relation(fields: [groupId], references: [id])
  membership        GroupMembership?   @relation(fields: [proposedByMembershipId], references: [id])
  projectMembership ProjectMembership? @relation("ContributionCategoryDraftProjectProposer", fields: [proposedByProjectMembershipId], references: [id])

  @@index([groupId])
  @@index([proposedByMembershipId])
  @@index([proposedByProjectMembershipId])
}

model ContributionCategory {
  id                 String             @id @default(cuid())
  groupId            String             // governance anchor — always a Group ID
  offeringEntityType OfferingEntityType
  offeringEntityId   String             // ID of the offering group/project/responsibility
  name               String
  description        String
  status             CategoryStatus     @default(active)
  createdAt          DateTime           @default(now())
  archivedAt         DateTime?

  group               Group                  @relation(fields: [groupId], references: [id])
  trustedProviders    TrustedProviderStatus[]
  serviceCapabilities ServiceCapability[]
  requestServices     SupportRequestService[]

  @@unique([offeringEntityType, offeringEntityId, name])
  @@index([groupId])
  @@index([offeringEntityType, offeringEntityId])
  @@index([status])
}

model TrustedProviderApplication {
  id           String   @id @default(cuid())
  membershipId String   // the member being trusted
  groupId      String
  categoryIds  Json     // String[] — IDs of ContributionCategory records
  requestedAt  DateTime @default(now())

  membership GroupMembership @relation(fields: [membershipId], references: [id])
  group      Group           @relation(fields: [groupId], references: [id])

  @@index([membershipId])
  @@index([groupId])
}

model TrustedProviderRevocationRequest {
  id                 String   @id @default(cuid())
  targetMembershipId String
  groupId            String
  statusIds          Json     // String[] — IDs of TrustedProviderStatus records to revoke
  requestedAt        DateTime @default(now())

  membership GroupMembership @relation(fields: [targetMembershipId], references: [id])
  group      Group           @relation(fields: [groupId], references: [id])

  @@index([targetMembershipId])
  @@index([groupId])
}

model TrustedProviderStatus {
  id           String                     @id @default(cuid())
  membershipId String
  categoryId   String
  groupId      String
  status       TrustedProviderStatusValue @default(active)
  grantedAt    DateTime                   @default(now())
  revokedAt    DateTime?

  membership GroupMembership      @relation(fields: [membershipId], references: [id])
  category   ContributionCategory @relation(fields: [categoryId], references: [id])
  group      Group                @relation(fields: [groupId], references: [id])

  @@unique([membershipId, categoryId])
  @@index([membershipId])
  @@index([categoryId])
  @@index([groupId])
  @@index([status])
}

model ContentCreationDraft {
  id                           String                @id @default(cuid())
  contentType                  ContentCreationType
  groupId                      String
  spaceType                    CoordinationSpaceType
  spaceId                      String
  publicationId                String?
  authorAccountId              String
  createdByMembershipId        String?
  createdByProjectMembershipId String?
  title                        String?
  body                         String?
  createdAt                    DateTime              @default(now())
  appliedAt                    DateTime?
  createdContentId             String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([appliedAt])
}

  @@index([groupId])
  @@index([projectId])
  @@index([supportRequestId])
  @@index([status])
  @@index([expiresAt])
}

model OfferService {
  id               String           @id @default(cuid())
  offerId          String
  serviceType      String
  trustRequirement TrustRequirement @default(lightweight)
  createdAt        DateTime         @default(now())

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([offerId, serviceType, trustRequirement])
  @@index([serviceType])
  @@index([trustRequirement])

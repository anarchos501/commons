generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  guest
  participant
  member
}

enum VisibilityLevel {
  private
  group
  project
  public
}

enum PrivacyLevel {
  private
  group
  project
  public
}

enum FederationPolicy {
  open
  allowlisted
  project_level
  read_only
  emergency_only
  disabled
}

enum PluginPolicy {
  open
  allowlisted
  reviewed
  disabled
}

enum ProjectStatus {
  active
  paused
  completed
  archived
}

enum TrustRequirement {
  lightweight
  elevated
}

enum ServiceCapabilityStatus {
  available
  petitioned
  approved
  revoked
  unavailable
}

enum TrustStatus {
  petitioned
  approved
  objected
  revoked
  expired
}

enum UrgencyLevel {
  low
  normal
  high
  urgent
}

enum SupportRequestStatus {
  open
  matched
  fulfilled
  expired
  deleted
}

enum OfferStatus {
  open
  accepted
  declined
  withdrawn
  expired
}

enum ProposalStatus {
  draft
  open
  approved
  rejected
  withdrawn
  implemented
}

enum RoleRecallPolicy {
  proposal
  consent
  emergency
}

enum GovernanceScope {
  node
  group
  project
  proposal
  service
  plugin
  contribution
  account
  trust
}

enum GovernanceChangeRule {
  mutable
  immutable
  stricter_only
  more_open_only
}

enum LinkedPresenceStatus {
  active
  migrating
  inactive
  revoked
}

enum SignedEventType {
  proposal_created
  support_request_submitted
  contribution_logged
  identity_presence_updated
  governance_preference_changed
  migration_prepared
}

enum DataClass {
  offline_draft
  personal_note
  local_reminder
  private_availability
  cached_coordination_history
  sync_queue_item
  support_request
  offer
  contribution
  proposal
  governance_preference
  portable_identity
  linked_node_presence
}

enum NodeStoragePolicy {
  none
  temporary
  canonical
  reference
}

enum LocalStoragePolicy {
  none
  cache
  draft
  private_data
  sync_queue
}

enum RequestRouteStatus {
  notified
  accepted
  declined
  expired
  cancelled
}

enum MembershipStatus {
  active
  pending
  inactive
  revoked
}

model Node {
  id                        String           @id @default(cuid())
  name                      String
  domain                    String           @unique
  constitutionalPreferences Json?
  federationPolicy          FederationPolicy @default(disabled)
  pluginPolicy              PluginPolicy     @default(disabled)
  createdAt                 DateTime         @default(now())

  accounts            Account[]
  groups              Group[]
  linkedNodePresences LinkedNodePresence[]
  signedEvents        SignedEvent[]
}

model PortableIdentity {
  id        String   @id @default(cuid())
  did       String   @unique
  publicKey String
  createdAt DateTime @default(now())

  accounts            Account[]
  linkedNodePresences LinkedNodePresence[]
  signedEvents        SignedEvent[]
}

model LinkedNodePresence {
  id                 String               @id @default(cuid())
  portableIdentityId String
  nodeId             String
  handle             String
  status             LinkedPresenceStatus @default(active)
  createdAt          DateTime             @default(now())
  lastSeenAt         DateTime?

  portableIdentity PortableIdentity @relation(fields: [portableIdentityId], references: [id])
  node             Node             @relation(fields: [nodeId], references: [id])

  @@unique([portableIdentityId, nodeId])
  @@index([nodeId])
  @@index([status])
}

model Account {
  id                 String          @id @default(cuid())
  portableIdentityId String?
  homeNodeId         String
  displayName        String
  email              String?         @unique
  passwordHash       String?
  accountType        AccountType     @default(guest)
  publicKey          String?
  profileVisibility  VisibilityLevel @default(private)
  createdAt          DateTime        @default(now())

  portableIdentity PortableIdentity? @relation(fields: [portableIdentityId], references: [id])
  homeNode         Node              @relation(fields: [homeNodeId], references: [id])

  serviceCapabilities ServiceCapability[]
  supportRequests     SupportRequest[]
  offers              Offer[]
  contributions       Contribution[]
  proposals           Proposal[]
  roles               Role[]
  actionLogs          ActionLog[]
  signedEvents        SignedEvent[]
  localSyncStates     LocalSyncState[]
  requestRoutes       RequestRoute[]
  availability        ContributorAvailability[]
  groupMemberships    GroupMembership[]

  @@index([homeNodeId])
  @@index([portableIdentityId])
  @@index([accountType])
}

model Group {
  id                    String   @id @default(cuid())
  nodeId                String
  name                  String
  description           String?
  membershipPolicy      String   @default("open")
  governancePreferences Json?
  privacyPreferences    Json?
  createdAt             DateTime @default(now())

  node             Node                       @relation(fields: [nodeId], references: [id])
  projects         Project[]
  trustApprovals   TrustedServiceCapability[]
  supportRequests  SupportRequest[]
  offers           Offer[]
  contributions    Contribution[]
  proposals        Proposal[]
  roles            Role[]
  actionLogs       ActionLog[]
  signedEvents     SignedEvent[]
  serviceOfferings GroupServiceOffering[]
  memberships      GroupMembership[]

  @@unique([nodeId, name])
  @@index([nodeId])
}

model GroupMembership {
  id        String           @id @default(cuid())
  accountId String
  groupId   String
  joinedAt  DateTime         @default(now())
  status    MembershipStatus @default(active)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([accountId, groupId])
  @@index([accountId])
  @@index([groupId])
}

model GroupServiceOffering {
  id                    String   @id @default(cuid())
  groupId               String
  serviceType           String
  status                String   @default("active")
  minimumContributorTrust String @default("lightweight")
  createdAt             DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@unique([groupId, serviceType])
  @@index([groupId])
  @@index([status])
}

model Project {
  id                    String        @id @default(cuid())
  groupId               String
  name                  String
  description           String?
  status                ProjectStatus @default(active)
  governancePreferences Json?
  privacyPreferences    Json?
  createdAt             DateTime      @default(now())

  group           Group            @relation(fields: [groupId], references: [id])
  supportRequests SupportRequest[]
  offers          Offer[]
  contributions   Contribution[]
  proposals       Proposal[]
  roles           Role[]
  actionLogs      ActionLog[]
  signedEvents    SignedEvent[]

  @@unique([groupId, name])
  @@index([groupId])
  @@index([status])
}

model ServiceCapability {
  id               String                  @id @default(cuid())
  accountId        String
  serviceType      String
  description      String?
  availability     Json?
  visibility       VisibilityLevel         @default(group)
  trustRequirement TrustRequirement        @default(lightweight)
  approvalStatus   ServiceCapabilityStatus @default(available)
  createdAt        DateTime                @default(now())

  account             Account                    @relation(fields: [accountId], references: [id])
  trustedRecords      TrustedServiceCapability[]
  requestRoutes       RequestRoute[]
  availabilityRecords ContributorAvailability[]

  @@unique([accountId, serviceType, trustRequirement])
  @@index([accountId])
  @@index([serviceType])
  @@index([approvalStatus])
  @@index([trustRequirement])
}

model TrustedServiceCapability {
  id                  String      @id @default(cuid())
  serviceCapabilityId String
  groupId             String
  trustContext        String
  status              TrustStatus @default(petitioned)
  supportThreshold    Float?
  reviewEndsAt        DateTime?
  approvedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime    @default(now())

  serviceCapability ServiceCapability @relation(fields: [serviceCapabilityId], references: [id])
  group             Group             @relation(fields: [groupId], references: [id])

  @@unique([serviceCapabilityId, groupId, trustContext])
  @@index([serviceCapabilityId])
  @@index([groupId])
  @@index([status])
}

model SupportRequest {
  id                   String               @id @default(cuid())
  submittedByAccountId String?
  guestRequestId       String?
  groupId              String
  projectId            String?
  requestType          String
  requestedServices    Json
  description          String
  urgency              UrgencyLevel         @default(normal)
  privacyLevel         PrivacyLevel         @default(private)
  status               SupportRequestStatus @default(open)
  expiresAt            DateTime?
  createdAt            DateTime             @default(now())

  submittedBy Account?                @relation(fields: [submittedByAccountId], references: [id])
  group       Group                   @relation(fields: [groupId], references: [id])
  project     Project?                @relation(fields: [projectId], references: [id])
  offers      Offer[]
  services    SupportRequestService[]
  routes      RequestRoute[]

  @@index([submittedByAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([status])
  @@index([expiresAt])
  @@index([urgency])
}

model SupportRequestService {
  id               String           @id @default(cuid())
  supportRequestId String
  serviceType      String
  trustRequirement TrustRequirement @default(lightweight)
  createdAt        DateTime         @default(now())

  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id])

  @@unique([supportRequestId, serviceType, trustRequirement])
  @@index([serviceType])
  @@index([trustRequirement])
}

model RequestRoute {
  id                   String             @id @default(cuid())
  supportRequestId     String
  contributorAccountId String
  serviceCapabilityId  String
  serviceType          String
  trustRequirement     TrustRequirement   @default(lightweight)
  status               RequestRouteStatus @default(notified)
  decisionNote         String?
  decidedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  supportRequest    SupportRequest    @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  contributor       Account           @relation(fields: [contributorAccountId], references: [id], onDelete: Cascade)
  serviceCapability ServiceCapability @relation(fields: [serviceCapabilityId], references: [id], onDelete: Cascade)

  @@unique([supportRequestId, contributorAccountId, serviceType, trustRequirement])
  @@index([supportRequestId])
  @@index([contributorAccountId])
  @@index([serviceCapabilityId])
  @@index([serviceType])
  @@index([trustRequirement])
  @@index([status])
  @@index([createdAt])
}

model ContributorAvailability {
  id                  String   @id @default(cuid())
  accountId           String
  serviceCapabilityId String?
  serviceType         String
  availability        Json
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  serviceCapability ServiceCapability? @relation(fields: [serviceCapabilityId], references: [id], onDelete: Cascade)

  @@unique([accountId, serviceType])
  @@index([accountId])
  @@index([serviceCapabilityId])
  @@index([serviceType])
  @@index([active])
}

model Offer {
  id               String       @id @default(cuid())
  accountId        String
  groupId          String
  projectId        String?
  supportRequestId String?
  offeredServices  Json
  description      String?
  availability     Json?
  status           OfferStatus  @default(open)
  privacyLevel     PrivacyLevel @default(group)
  expiresAt        DateTime?
  createdAt        DateTime     @default(now())

  account        Account         @relation(fields: [accountId], references: [id])
  group          Group           @relation(fields: [groupId], references: [id])
  project        Project?        @relation(fields: [projectId], references: [id])
  supportRequest SupportRequest? @relation(fields: [supportRequestId], references: [id])
  services       OfferService[]

  @@index([accountId])
  @@index([groupId])
  @@index([projectId])
  @@index([supportRequestId])
  @@index([status])
  @@index([expiresAt])
}

model OfferService {
  id               String           @id @default(cuid())
  offerId          String
  serviceType      String
  trustRequirement TrustRequirement @default(lightweight)
  createdAt        DateTime         @default(now())

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([offerId, serviceType, trustRequirement])
  @@index([serviceType])
  @@index([trustRequirement])
}

model Contribution {
  id                   String          @id @default(cuid())
  contributorAccountId String
  groupId              String?
  projectId            String?
  contributionType     String
  description          String
  quantity             String?
  occurredAt           DateTime
  visibility           VisibilityLevel @default(group)
  privacyEnvelope      Json?
  createdAt            DateTime        @default(now())

  contributor Account  @relation(fields: [contributorAccountId], references: [id])
  group       Group?   @relation(fields: [groupId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])

  @@index([contributorAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([occurredAt])
  @@index([visibility])
}

model Proposal {
  id                            String         @id @default(cuid())
  groupId                       String
  projectId                     String?
  title                         String
  body                          String
  status                        ProposalStatus @default(open)
  governancePreferencesSnapshot Json?
  createdByAccountId            String
  createdAt                     DateTime       @default(now())
  resolvedAt                    DateTime?

  group     Group    @relation(fields: [groupId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
  createdBy Account  @relation(fields: [createdByAccountId], references: [id])

  @@index([groupId])
  @@index([projectId])
  @@index([createdByAccountId])
  @@index([status])
}

model Role {
  id           String           @id @default(cuid())
  accountId    String
  roleType     String
  permissions  Json
  groupId      String?
  projectId    String?
  startsAt     DateTime         @default(now())
  expiresAt    DateTime
  recallPolicy RoleRecallPolicy @default(proposal)
  createdAt    DateTime         @default(now())

  account Account  @relation(fields: [accountId], references: [id])
  group   Group?   @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([accountId])
  @@index([groupId])
  @@index([projectId])
  @@index([expiresAt])
}

model GovernancePreference {
  id         String               @id @default(cuid())
  key        String
  value      Json
  scope      GovernanceScope
  scopeId    String?
  changeRule GovernanceChangeRule @default(mutable)
  createdBy  String
  createdAt  DateTime             @default(now())

  @@index([scope, scopeId])
  @@index([key])
}

model PrivacyEnvelope {
  id         String       @id @default(cuid())
  targetType String
  targetId   String
  level      PrivacyLevel @default(private)
  rules      Json?
  createdBy  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([targetType, targetId])
  @@index([level])
}

model ActionLog {
  id             String   @id @default(cuid())
  actorAccountId String?
  groupId        String?
  projectId      String?
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor   Account? @relation(fields: [actorAccountId], references: [id])
  group   Group?   @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([actorAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SignedEvent {
  id                 String          @id @default(cuid())
  eventType          SignedEventType
  subjectType        String
  subjectId          String
  actorAccountId     String?
  portableIdentityId String?
  nodeId             String?
  groupId            String?
  projectId          String?
  payload            Json
  payloadHash        String
  signature          String
  publicKey          String
  createdAt          DateTime        @default(now())

  actor            Account?          @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  portableIdentity PortableIdentity? @relation(fields: [portableIdentityId], references: [id], onDelete: SetNull)
  node             Node?             @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  group            Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([payloadHash, signature])
  @@index([eventType])
  @@index([subjectType, subjectId])
  @@index([actorAccountId])
  @@index([portableIdentityId])
  @@index([nodeId])
  @@index([groupId])
  @@index([projectId])
  @@index([createdAt])
}

model LocalSyncState {
  id               String    @id @default(cuid())
  accountId        String
  deviceId         String
  lastAckedEventId String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceId])
  @@index([lastAckedEventId])
  @@index([lastSyncedAt])
}

model DataReplicationPolicy {
  id                  String             @id @default(cuid())
  scope               GovernanceScope
  scopeId             String
  dataClass           DataClass
  nodeStorage         NodeStoragePolicy
  localStorage        LocalStoragePolicy
  federationAllowed   Boolean            @default(false)
  p2pAllowed          Boolean            @default(false)
  retentionDays       Int?
  requiresEncryption  Boolean            @default(true)
  userExportAllowed   Boolean            @default(true)
  userDeletionAllowed Boolean            @default(true)
  syncRequiresConsent Boolean            @default(true)
  createdAt           DateTime           @default(now())

  @@unique([scope, scopeId, dataClass])
  @@index([dataClass])
  @@index([scope, scopeId])
  @@index([federationAllowed])
  @@index([p2pAllowed])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  guest
  participant
  member
}

enum VisibilityLevel {
  private
  group
  project
  public
}

enum PrivacyLevel {
  private
  group
  project
  public
}

enum GroupVisibility {
  private
  public
}

enum FederationPolicy {
  open
  allowlisted
  project_level
  read_only
  emergency_only
  disabled
}

enum PluginPolicy {
  open
  allowlisted
  reviewed
  disabled
}

// F3.5 Phase 0 (C0 core pulled forward): who may join this node. ALL rows —
// including new nodes — default `open` until C0 ships actual gating and flips
// the creation default in the same commit: the mode feeds registration
// legibility AND backup consent (register F-10), so it must never label a
// door that doesn't exist.
enum RegistrationMode {
  open
  invite_only
}

enum ProjectStatus {
  active    // at least one active project member
  quiet     // no active members; at least one quiet member remains
  dormant   // no active or quiet members remain — independent of hosting (RFC-007: see ProjectHosting/pendingClosureAt for the separate, derived hosting axis)
  completed // mission intentionally fulfilled by project members; a one-way exit — never enters pending closure, never becomes closed (RFC-007)
  closed    // automatic: pending-closure grace period (30 days) elapsed with no mutually-approved successor host (RFC-007 amends this trigger; previously "no members AND no host groups")
}

enum TrustRequirement {
  lightweight
  elevated
}

enum ServiceCapabilityStatus {
  available
  petitioned
  approved
  revoked
  unavailable
}

enum TrustStatus {
  petitioned
  approved
  objected
  revoked
  expired
}

enum UrgencyLevel {
  low
  normal
  high
  urgent
}

enum SupportRequestStatus {
  open
  routed
  matched
  fulfilled
  expired
  deleted
}

enum OfferStatus {
  open
  accepted
  declined
  withdrawn
  expired
}

enum ProposalStatus {
  draft
  open
  approved
  rejected
  withdrawn
  implemented
}

enum AssignmentEndReason {
  expired
  quiet
  dormant
  recall
  resigned
}

enum CoordinationAbility {
  // Communication — D3 implements the models; abilities recorded now
  create_bulletins
  create_publications
  create_publication_entries
  // Coordination
  create_projects
  issue_support_requests
  issue_contribution_offers
  approve_membership
  // Contribution Categories — RFC: Contribution Categories & Trusted Provider Status
  create_contribution_categories
  // Accountability — in enum for completeness; NOT wired into platform behavior in D2.
  // Reviewer checks continue using hasActiveEligibleAssignment (see concerns.ts).
  review_concerns
  issue_findings
  issue_action_proposals
  administrative_closure
}

enum OfferingEntityType {
  group
  project
  responsibility
}

enum CategoryStatus {
  active
  archived
}

enum TrustedProviderStatusValue {
  active
  revoked
}

enum AbilityAvailability {
  always_available
  available_during_emergency // activation mechanics deferred to Governance RFC
}

enum CoordinationSpaceType {
  group
  project
  responsibility
  coalition
}

enum GovernanceScope {
  node
  group
  project
  coalition
  proposal
  service
  plugin
  contribution
  account
  trust
}

enum GovernanceChangeRule {
  mutable
  immutable
  stricter_only
  more_open_only
}

enum LinkedPresenceStatus {
  active
  migrating
  inactive
  revoked
}

enum SignedEventType {
  proposal_created
  support_request_submitted
  contribution_logged
  identity_presence_updated
  governance_preference_changed
  migration_prepared
  mediated_action_requested
}

enum DataClass {
  offline_draft
  personal_note
  local_reminder
  private_availability
  cached_coordination_history
  sync_queue_item
  support_request
  offer
  contribution
  proposal
  governance_preference
  portable_identity
  linked_node_presence
}

enum NodeStoragePolicy {
  none
  temporary
  canonical
  reference
}

enum LocalStoragePolicy {
  none
  cache
  draft
  private_data
  sync_queue
}

enum RequestRouteStatus {
  notified
  accepted
  declined
  expired
  cancelled
  // Contributor-side terminal states (feedback #5): the accepting contributor can clear a
  // route from their inbox. `completed` = support provided (a Contribution is recorded; the
  // request stays `matched` until the requester confirms via fulfillSupportRequest).
  // `unreachable` = couldn't reach the requester (request stays `matched`; the requester is
  // notified and may reopen it for re-routing to all eligible contributors).
  completed
  unreachable
}

enum MembershipStatus {
  active
  pending
  inactive
  revoked
}

enum ParticipationStatus {
  active
  quiet
  dormant
}

enum ReportStatus {
  open
  under_review
  findings_issued
  action_proposed
  // Reporter has withdrawn but the concern is NOT closed: eligible reviewers may
  // continue if a live safety/accountability issue remains (RFC-002). Not terminal.
  withdrawn
  closed
  // Legacy values preserved for backward compatibility
  resolved
  dismissed
}

enum ConcernFindingOutcome {
  substantiated
  partially_substantiated
  unsubstantiated
  insufficient_information
  withdrawn
}

// Distinguishes a person-accountability concern (may name a subject; remedy acts on a person)
// from a content/request flag (no subject; remedy acts on the request itself, e.g. spam/fraud).
// Both are Report rows, but reviewers need to know which kind they are looking at.
enum ReportKind {
  person_concern
  request_flag
}

enum ConcernClosureReason {
  reporter_withdrawal
  review_complete_no_action
  action_accepted_and_implemented
  action_rejected_no_further_proposal
  administrative_closure
}

enum ConcernProposalStatus {
  pending
  accepted
  rejected
  superseded
}

enum ContentCreationType {
  bulletin
  publication
  publication_entry
  living_document
}

// RFC-008: Coordination Events & Shared Calendars
enum EventHostType {
  group
  project
  responsibility
  coalition
  account // personal events
}

enum EventCategory {
  meeting
  workshop
}

enum EventVisibility {
  host_only
  audience
  public
}

enum EventInterestLevel {
  planning_to_attend
  interested
}

model Node {
  id                        String           @id @default(cuid())
  name                      String
  domain                    String           @unique
  stewardGroupId            String?
  stewardRevision           Int              @default(0)
  constitutionalPreferences Json?
  federationPolicy          FederationPolicy @default(disabled)
  registrationMode          RegistrationMode @default(open)
  // F3.5 (register F-10): backup-hosting consent knobs. Threshold: null = no
  // cap; over-threshold requests auto-convert into the steward consent
  // petition (escalate, never refuse). Policy applies when invite_only.
  backupMemberThreshold     Int?
  backupHostingPolicy       String           @default("approve_each") // accept | approve_each | refuse
  pluginPolicy              PluginPolicy     @default(disabled)
  createdAt                 DateTime         @default(now())

  stewardGroup         Group?                 @relation("NodeStewardGroup", fields: [stewardGroupId], references: [id], onDelete: SetNull)
  accounts            Account[]
  groups              Group[]
  coalitions          Coalition[]
  hosts               NodeHost[]
  governanceSignals   NodeGovernanceSignal[]
  petitionSupport     NodePetitionSupport[]
  stewardProposals    NodeStewardProposal[]
  nodeNameProposals   NodeNameProposal[]
  actionLogs          ActionLog[]
  linkedNodePresences LinkedNodePresence[]
  signedEvents        SignedEvent[]
  feedbackReports     FeedbackReport[]
  feedbackDigests     FeedbackDigest[]
  keyPairs            NodeKeyPair[]

  @@index([stewardGroupId])
}

model PortableIdentity {
  id        String   @id @default(cuid())
  did       String   @unique
  publicKey String
  createdAt DateTime @default(now())

  accounts            Account[]
  linkedNodePresences LinkedNodePresence[]
  signedEvents        SignedEvent[]
  keyCustody          IdentityKeyCustody?
}

// Node-custodied member keys (register D-8: a MOVABLE custody boundary — the
// private-key columns are isolated here so Rung 2 relocates custody by nulling
// them and adding a client wrap, never by reshaping content tables). The
// X25519 encryption pair is provisioned now so F4 needs no re-keying.
model IdentityKeyCustody {
  id                      String    @id @default(cuid())
  portableIdentityId      String    @unique
  signingPrivateKeyPem    String
  encryptionPublicKey     String?
  encryptionPrivateKeyPem String?
  // F3.5 key escrow (register D-8's demanded recovery design): the identity
  // key WRAPPED (not derived) under scrypt(password, escrowSalt) + AES-GCM.
  // This custody row stays PRIMARY — password change rewraps; the wrapped
  // blob rides backup replicas' cannot-read tier for stranded login.
  escrowSalt              String?
  escrowWrappedKey        String?
  escrowUpdatedAt         DateTime?
  createdAt               DateTime  @default(now())
  revokedAt               DateTime?

  portableIdentity PortableIdentity @relation(fields: [portableIdentityId], references: [id], onDelete: Cascade)
}

model LinkedNodePresence {
  id                 String               @id @default(cuid())
  portableIdentityId String
  nodeId             String
  handle             String
  displayName        String?
  homeNodeDomain     String?
  status             LinkedPresenceStatus @default(active)
  createdAt          DateTime             @default(now())
  lastSeenAt         DateTime?

  portableIdentity PortableIdentity @relation(fields: [portableIdentityId], references: [id])
  node             Node             @relation(fields: [nodeId], references: [id])

  @@unique([portableIdentityId, nodeId])
  @@index([nodeId])
  @@index([status])
}

// --- Inter-node federation (F0: protocol & peering; register F-4, D-3) ---

// This node's own signing keys. Multiple rows allow rotation (F5); a raw
// partial unique index ("one active per node", retiredAt IS NULL) lives in
// the migration because Prisma cannot express partial indexes.
model NodeKeyPair {
  id            String    @id @default(cuid())
  nodeId        String
  algorithm     String    @default("ed25519")
  publicKey     String
  privateKeyPem String
  createdAt     DateTime  @default(now())
  retiredAt     DateTime?

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
}

// A peer node this node knows about. Trust is pinned to the key, not just
// the domain (TOFU at proposal time, confirmed via /.well-known/commons).
// domain is the canonical identity (portless, matches the peer's Node.domain
// and envelope origin.domain); inboxUrl is the delivery address — they differ
// in the two-node dev harness, where ports distinguish instances.
model FederatedNode {
  id             String    @id @default(cuid())
  domain         String    @unique
  displayName    String?
  publicKey      String
  inboxUrl       String?
  status         String    @default("proposed") // proposed | active | suspended | ended
  policySnapshot Json?
  pinnedAt       DateTime  @default(now())
  lastSeenAt     DateTime?
  // F3.5 lease visibility (register F-9): last successful outbound delivery.
  // Lease contact = max(lastSeenAt, lastOutboundOkAt) over active peers —
  // DB-persisted so every instance agrees and it is honestly stale after
  // downtime (quiet-boot depends on that).
  lastOutboundOkAt DateTime?
  endedAt        DateTime?

  outboxItems           FederationOutboxItem[]
  inboundEvents         FederationInboundEvent[]
  federationMemberships FederationMembership[]
  visibilityGrants      FederatedVisibilityGrant[]
  groupPresences        FederatedGroupPresence[]
  coalitionPresences    FederatedCoalitionPresence[]
  entityBackups         EntityBackup[]               @relation("EntityBackupPeer")
  backupReplicas        BackupReplica[]              @relation("BackupReplicaOrigin")

  @@index([status])
}

// --- Inter-node federation (F1: governance — agreements & mutual consent) ---

// A federation agreement (register F-2, F-5). id is shared across nodes: the
// formation proposal's UUID becomes the agreement's id, so both databases
// converge on the same identifier with no coordinator.
model Federation {
  id          String    @id
  name        String
  status      String    @default("active") // active | dissolved
  terms       Json
  createdAt   DateTime  @default(now())
  dissolvedAt DateTime?

  memberships FederationMembership[]
  proposals   FederationProposal[]

  @@index([status])
}

model FederationMembership {
  id              String    @id @default(cuid())
  federationId    String
  memberDomain    String
  federatedNodeId String? // null when this row is this node itself
  isSelf          Boolean   @default(false)
  joinedAt        DateTime  @default(now())
  endedAt         DateTime?
  endReason       String?

  federation    Federation     @relation(fields: [federationId], references: [id], onDelete: Cascade)
  federatedNode FederatedNode? @relation(fields: [federatedNodeId], references: [id], onDelete: SetNull)

  @@unique([federationId, memberDomain])
  @@index([federatedNodeId])
  @@index([endedAt])
}

// Cross-node sibling of CoalitionProposal. id is the shared proposal UUID
// minted by the initiating node; each participating node holds its own row
// plus ONE steward-group petition, and the decisions map converges through
// signed federation_proposal_decision events — decisions are monotonic
// (pending → terminal, never back) and each side applies independently on
// unanimity. No distributed locks, no coordinator.
model FederationProposal {
  id                  String    @id
  federationId        String?
  action              String // formation | join | departure | removal
  initiatedByDomain   String
  name                String?
  content             String
  terms               Json
  participantSnapshot Json // { capturedAt, domains: string[] }
  decisions           Json // { [domain]: "pending" | "approved" | "rejected" }
  status              String    @default("open") // open | awaiting_remote | succeeded | failed-rejected | failed-withdrawn | failed-timeout
  closesAt            DateTime
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  federation Federation?                  @relation(fields: [federationId], references: [id])
  petitions  FederationProposalPetition[]

  @@index([federationId])
  @@index([action])
  @@index([status, closesAt])
}

// Links this node's steward petition to the shared proposal — exact sibling
// of CoalitionProposalPetition. A node's database only ever holds its OWN
// petition row; remote nodes' petitions are visible only as decisions.
model FederationProposalPetition {
  id         String   @id @default(cuid())
  proposalId String
  petitionId String   @unique
  nodeDomain String
  role       String // participant | applicant | departing | remaining_member
  snapshot   Json
  createdAt  DateTime @default(now())

  proposal FederationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, nodeDomain])
  @@index([proposalId])
}

// Outbound delivery queue: enqueue inside the local transaction, deliver via
// the instrumentation sweep with backoff — never synchronously in a request.
model FederationOutboxItem {
  id            String    @id @default(cuid())
  eventId       String    @unique
  peerId        String
  eventType     String
  envelope      Json
  status        String    @default("pending") // pending | delivered | dead
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  peer FederatedNode @relation(fields: [peerId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([peerId])
}

// F3.5 HOME side (register F-8): this node's entity has designated a backup
// elsewhere. verifiedAt is the quiet-boot marker: NULL means "do not trust
// your own database for this entity" (register F-9) — a per-request DB check,
// deliberately never an in-memory flag.
model EntityBackup {
  id               String    @id @default(cuid())
  entityType       String // group | project | coalition — generic from day one
  entityId         String
  peerId           String
  windowHours      Int       @default(24) // W; floor 1 enforced in code
  directive        String    @default("none") // reconstitute | none (advance directive, F-6)
  status           String    @default("proposed") // proposed | active | refused | revoked | ended
  establishedAt    DateTime?
  manifestSeq      Int       @default(0)
  lastManifest     Json?
  lastReplicatedAt DateTime?
  verifiedAt       DateTime?
  takeoverState    String    @default("none") // none | remote_active | ceding
  lastAppliedSeq   Int       @default(0)
  createdAt        DateTime  @default(now())

  peer FederatedNode @relation("EntityBackupPeer", fields: [peerId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([peerId])
  @@index([status])
}

// F3.5 BACKUP side: an inert replica of a remote entity, walled off by
// construction — its data lives ONLY here + TakeoverLogEntry; no Group /
// Account / Membership rows are ever created for it, so local rosters,
// denominators, and notifications cannot see it (register F-8, D-10).
model BackupReplica {
  id                 String    @id @default(cuid())
  entityType         String
  entityId           String // the HOME's id (shared-id convention)
  originPeerId       String
  entityName         String
  memberCount        Int // home-asserted, locals only (register F-10)
  windowHours        Int
  directive          String    @default("none")
  manifest           Json?
  // Cannot-read tier (register D-10): password-wrapped identity keys for
  // stranded login. Ciphertext by construction — this node holds blobs it
  // cannot open.
  escrowEntries      Json?
  manifestSeq        Int       @default(0)
  status             String    @default("pending_consent") // pending_consent | active | challenge_open | takeover_active | ceding | ended | refused
  consentPetitionId  String?
  challengeOpenedAt  DateTime?
  lastProofOfLifeAt  DateTime?
  expediteApprovedAt DateTime?
  activatedAt        DateTime?
  cededAt            DateTime?
  createdAt          DateTime  @default(now())

  origin     FederatedNode      @relation("BackupReplicaOrigin", fields: [originPeerId], references: [id], onDelete: Cascade)
  logEntries TakeoverLogEntry[]

  @@unique([entityType, entityId, originPeerId])
  @@index([status])
}

// F3.5 Tier-2 coordination annex (register F-8, ratified log-only): a signed
// append-only log of takeover writes; replayed on the home at cede.
model TakeoverLogEntry {
  id             String   @id @default(cuid())
  replicaId      String
  seq            Int
  actionType     String // takeover_post_message | takeover_join_open_group
  action         Json
  actorLabel     String
  actorAccountId String?
  signature      String
  createdAt      DateTime @default(now())

  replica BackupReplica @relation(fields: [replicaId], references: [id], onDelete: Cascade)

  @@unique([replicaId, seq])
}

// register D-4: per-(collective, peer-node) visibility grants — the §2b
// consent layer. Absent row = closed. Public-group instrument only (A3):
// validation rejects private groups. Suspension is agreement-scoped
// (soft-archive on dissolve, resume on re-federation), never deletion.
model FederatedVisibilityGrant {
  id              String    @id @default(cuid())
  groupId         String
  federatedNodeId String
  stance          String    @default("closed") // closed | visible | interactive
  suspendedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  federatedNode FederatedNode @relation(fields: [federatedNodeId], references: [id], onDelete: Cascade)

  @@unique([groupId, federatedNodeId])
  @@index([federatedNodeId])
}

// Home-side record of a REMOTE member group in a cross-node coalition (A4:
// hub topology — the home node holds the canonical membership; the remote
// group's node holds a FederatedCoalitionPresence). Name is the disclosure
// the remote group consented to by joining (A3: scoped to this shared
// entity's membership, never to the peer node broadly).
model FederatedGroupPresence {
  id              String    @id @default(cuid())
  federatedNodeId String
  remoteGroupId   String
  name            String
  status          String    @default("active") // active | suspended | ended
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())

  federatedNode        FederatedNode         @relation(fields: [federatedNodeId], references: [id], onDelete: Cascade)
  coalitionMemberships CoalitionMembership[]

  @@unique([federatedNodeId, remoteGroupId])
}

// Member-side record: OUR group belongs to a coalition homed elsewhere.
// coalitionId is the home node's coalition id (shared, like federation ids).
model FederatedCoalitionPresence {
  id                  String   @id @default(cuid())
  coalitionId         String
  homeFederatedNodeId String
  groupId             String
  name                String
  status              String   @default("active") // active | suspended | ended
  createdAt           DateTime @default(now())

  homeFederatedNode FederatedNode               @relation(fields: [homeFederatedNodeId], references: [id], onDelete: Cascade)
  group             Group                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages          FederatedCoalitionMessage[]

  @@unique([coalitionId, groupId])
}

// Member-side cache of coalition coordination content, relayed by the home
// node (aggregated reads are local-cache reads — never a synchronous
// cross-node fetch in RSC). Tagged with the AUTHOR's origin domain.
model FederatedCoalitionMessage {
  id              String   @id @default(cuid())
  presenceId      String
  remoteMessageId String
  originDomain    String
  authorLabel     String
  body            String
  postedAt        DateTime
  receivedAt      DateTime @default(now())

  presence FederatedCoalitionPresence @relation(fields: [presenceId], references: [id], onDelete: Cascade)

  @@unique([presenceId, remoteMessageId])
  @@index([presenceId, postedAt])
}

// Inbound event ledger: the unique(origin, remoteEventId) pair is the replay
// guard — insert-first, catch P2002 as "duplicate" (register F-4). outcome is
// null until the handler transaction completes.
model FederationInboundEvent {
  id            String    @id @default(cuid())
  originNodeId  String
  remoteEventId String
  eventType     String
  envelope      Json
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  outcome       String? // applied | rejected | duplicate | error
  error         String?

  origin FederatedNode @relation(fields: [originNodeId], references: [id], onDelete: Cascade)

  @@unique([originNodeId, remoteEventId])
  @@index([originNodeId])
  @@index([eventType])
}

model Account {
  id                 String          @id @default(cuid())
  portableIdentityId String?
  homeNodeId         String
  displayName        String
  email              String?         @unique
  passwordHash       String?
  accountType        AccountType     @default(guest)
  publicKey          String?
  profileVisibility  VisibilityLevel @default(private)
  createdAt          DateTime        @default(now())

  portableIdentity PortableIdentity? @relation(fields: [portableIdentityId], references: [id])
  homeNode         Node              @relation(fields: [homeNodeId], references: [id])

  serviceCapabilities       ServiceCapability[]
  supportRequests           SupportRequest[]
  offers                    Offer[]
  contributions             Contribution[]
  proposals                 Proposal[]
  actionLogs                ActionLog[]
  signedEvents        SignedEvent[]
  localSyncStates     LocalSyncState[]
  requestRoutes       RequestRoute[]
  availability        ContributorAvailability[]
  groupMemberships    GroupMembership[]
  projectMemberships  ProjectMembership[]
  reportsSubmitted        Report[] @relation("ConcernReporter")
  concernsAbout           Report[] @relation("ConcernSubject")
  concernReviews          ConcernReview[]
  concernFindings         ConcernFinding[]
  concernProposals        ConcernActionProposal[]
  bulletins               Bulletin[]
  publicationsCreated     Publication[]
  publicationEntries      PublicationEntry[]
  livingDocumentRevisions LivingDocumentRevision[]
  discussionThreadsCreated DiscussionThread[]
  discussionMessages       DiscussionMessage[]
  discussionThreadReads    DiscussionThreadRead[]
  nodeHostRecords          NodeHost[]
  nodeGovernanceSignals    NodeGovernanceSignal[]
  nodePetitionSupport      NodePetitionSupport[]
  nodeStewardProposals     NodeStewardProposal[]
  createdNodePetitions     Petition[] @relation("PetitionAccountCreator")
  feedbackReports          FeedbackReport[]
  calendarEventsCreated    CalendarEvent[] @relation("CalendarEventCreator")
  eventInterests           EventInterest[] @relation("EventInterestAccount")
  calendarFilterPreference CalendarFilterPreference? @relation("CalendarFilterPrefs")
  notificationPreference   NotificationPreference?   @relation("NotificationPrefs")
  uiDisclosurePreference   UiDisclosurePreference?   @relation("UiDisclosurePrefs")

  @@index([homeNodeId])
  @@index([portableIdentityId])
  @@index([accountType])
}

model Group {
  id                    String   @id @default(cuid())
  nodeId                String
  name                  String
  description           String?
  membershipPolicy      String          @default("open")
  visibility            GroupVisibility @default(private)
  governancePreferences Json?
  privacyPreferences    Json?
  // When true, requesters may send a free-text "custom" support request even if the group has
  // defined no contribution categories. Routed to the group's opted-in active members. For
  // private groups this is reachable only via the token-gated share link — never public pages.
  acceptsCustomRequests Boolean         @default(false)
  // Set when a group loses its last active member. An archived group is hidden everywhere and is
  // eligible for hard deletion after a grace period (deletion itself is deferred — see roadmap).
  archivedAt            DateTime?
  createdAt             DateTime @default(now())

  node             Node                       @relation(fields: [nodeId], references: [id])
  federatedVisibilityGrants FederatedVisibilityGrant[]
  federatedCoalitionPresences FederatedCoalitionPresence[]
  foundedProjects  Project[]
  hostedProjects   ProjectHosting[]
  hostingProposals ProjectHostingProposal[]
  coalitionMemberships CoalitionMembership[]
  coalitionProposalsSponsored CoalitionProposal[] @relation("CoalitionProposalSponsor")
  coalitionProposalPetitions CoalitionProposalPetition[]
  stewardForNodes            Node[] @relation("NodeStewardGroup")
  nodeStewardCandidates      NodeStewardProposal[] @relation("NodeStewardCandidate")
  nodeStewardInitiations     NodeStewardProposal[] @relation("NodeStewardInitiatingGroup")
  nodeNameInitiations        NodeNameProposal[]    @relation("NodeNameInitiatingGroup")
  trustApprovals   TrustedServiceCapability[]
  supportRequests  SupportRequest[]
  offers           Offer[]
  contributions    Contribution[]
  proposals        Proposal[]
  responsibilities Responsibility[]
  actionLogs       ActionLog[]
  signedEvents     SignedEvent[]
  serviceOfferings GroupServiceOffering[]
  memberships        GroupMembership[]
  reports            Report[]
  concernReviews     ConcernReview[]
  concernFindings    ConcernFinding[]
  concernProposals   ConcernActionProposal[]
  governanceSignals              MemberGovernanceSignal[]
  petitions                      Petition[]
  emergencyPeriods               EmergencyPeriod[]
  contributionCategories         ContributionCategory[]
  contributionCategoryDrafts     ContributionCategoryDraft[]
  trustedProviderApplications    TrustedProviderApplication[]
  trustedProviderRevocations     TrustedProviderRevocationRequest[]
  trustedProviderStatuses        TrustedProviderStatus[]
  inviteTokens                   GroupInviteToken[]
  requestLinks                   GroupRequestLink[]
  contentCreationDrafts          ContentCreationDraft[]
  responsibilityProposalDrafts   ResponsibilityProposalDraft[]

  @@unique([nodeId, name])
  @@index([nodeId])
  @@index([archivedAt])
}

model NodeHost {
  id        String    @id @default(cuid())
  nodeId    String
  accountId String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  node    Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([accountId])
  @@index([revokedAt])
}

model FeedbackReport {
  id                       String   @id @default(cuid())
  nodeId                   String
  accountId                String?
  type                     String
  title                    String
  body                     String
  expected                 String?
  path                     String?
  userAgent                String?
  appVersion               String?
  status                   String   @default("new")
  githubIssueUrl           String?
  hostNotes                String?
  redactedTitle            String?
  redactedBody             String?
  redactedExpected         String?
  redactedPath             String?
  redactedUserAgent        String?
  redactedAppVersion       String?
  anonymousFingerprintHash String?
  // Set when the report is compiled into a saved digest (status becomes "archived"); clears it
  // from the active inbox while preserving the local record.
  digestId                 String?
  createdAt                DateTime @default(now())
  reviewedAt               DateTime?
  resolvedAt               DateTime?

  node    Node            @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  account Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  digest  FeedbackDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  @@index([nodeId, status, createdAt])
  @@index([nodeId, anonymousFingerprintHash, createdAt])
  @@index([accountId])
  @@index([digestId])
}

// A node host can compile reviewed reports into a single saved document, clearing them from the
// active inbox while keeping a chronological archive. The body is markdown built from the reports'
// redacted fields (the shareable "export draft").
model FeedbackDigest {
  id          String   @id @default(cuid())
  nodeId      String
  title       String
  body        String
  reportCount Int
  compiledAt  DateTime @default(now())

  node    Node             @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  reports FeedbackReport[]

  @@index([nodeId, compiledAt])
}

model NodeGovernanceSignal {
  id        String   @id @default(cuid())
  nodeId    String
  accountId String
  category  String
  parameter String   @default("_")
  signal    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  node    Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, nodeId, category, parameter])
  @@index([nodeId, category])
}

model NodeStewardProposal {
  id                        String    @id @default(cuid())
  nodeId                    String
  action                    String    // appointment | no_confidence | resignation
  origin                    String    // host | group
  candidateGroupId          String
  initiatingGroupId         String?
  initiatedByAccountId      String?
  baselineStewardGroupId    String?
  baselineStewardRevision   Int
  groupInitiationPetitionId String?   @unique
  candidateConsentPetitionId String?  @unique
  nodePetitionId            String?   @unique
  status                    String    @default("open") // open | awaiting_candidate_consent | awaiting_node_vote | succeeded | failed-rejected | failed-withdrawn | failed-stale
  snapshot                  Json
  createdAt                 DateTime  @default(now())
  resolvedAt                DateTime?

  node            Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  candidateGroup  Group    @relation("NodeStewardCandidate", fields: [candidateGroupId], references: [id])
  initiatingGroup Group?   @relation("NodeStewardInitiatingGroup", fields: [initiatingGroupId], references: [id])
  initiatedBy     Account? @relation(fields: [initiatedByAccountId], references: [id], onDelete: SetNull)

  @@index([nodeId, status])
  @@index([candidateGroupId])
  @@index([initiatingGroupId])
  @@index([initiatedByAccountId])
}

// A group internally petitions a proposed node name; on group approval it escalates to a node-wide
// vote, and on node approval the node is renamed. Mirrors the NodeStewardProposal escalation.
model NodeNameProposal {
  id                String    @id @default(cuid())
  nodeId            String
  initiatingGroupId String
  proposedName      String
  groupPetitionId   String?   @unique
  nodePetitionId    String?   @unique
  status            String    @default("awaiting_group") // awaiting_group | awaiting_node_vote | succeeded | failed-rejected | failed-withdrawn
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  node            Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  initiatingGroup Group @relation("NodeNameInitiatingGroup", fields: [initiatingGroupId], references: [id])

  @@index([nodeId, status])
  @@index([initiatingGroupId])
}

model Coalition {
  id          String    @id @default(cuid())
  nodeId      String
  name        String
  description String?
  status      String    @default("active") // active | dissolved
  createdAt   DateTime  @default(now())
  dissolvedAt DateTime?

  node        Node                  @relation(fields: [nodeId], references: [id])
  memberships CoalitionMembership[]
  proposals   CoalitionProposal[]

  @@unique([nodeId, name])
  @@index([nodeId])
  @@index([status])
}

model CoalitionMembership {
  id          String    @id @default(cuid())
  coalitionId String
  // A member is EITHER a local Group or a remote FederatedGroupPresence —
  // exactly one, enforced structurally by the CoalitionMembership_member_xor
  // CHECK constraint (never by convention). Every LOCAL read path narrows on
  // groupId != null.
  groupId                   String?
  federatedGroupPresenceId  String?
  joinedAt    DateTime  @default(now())
  endedAt     DateTime?
  endReason   String?

  coalition               Coalition               @relation(fields: [coalitionId], references: [id])
  group                   Group?                  @relation(fields: [groupId], references: [id])
  federatedGroupPresence  FederatedGroupPresence? @relation(fields: [federatedGroupPresenceId], references: [id])

  @@index([coalitionId])
  @@index([groupId])
  @@index([endedAt])
}

model CoalitionProposal {
  id                  String    @id @default(cuid())
  coalitionId         String?
  action              String    // formation | join | departure | removal
  proposedByGroupId   String
  targetGroupId       String?
  name                String?
  description         String?
  content             String
  participantSnapshot Json
  // Cross-node (F3): null = this node is the coalition's home. Set on the
  // MEMBER side to the home node's domain — resolution then mirrors the
  // home's signed outcome instead of local evaluation.
  homeNodeDomain      String?
  // Home-side remote consent map, keyed `${domain}:${remoteGroupId}` →
  // pending|approved|rejected (the federation-consent shape).
  decisions           Json?
  status              String    @default("open") // open | succeeded | failed-rejected | failed-withdrawn | failed-timeout
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  coalition       Coalition?                  @relation(fields: [coalitionId], references: [id])
  proposedByGroup Group                       @relation("CoalitionProposalSponsor", fields: [proposedByGroupId], references: [id])
  petitions       CoalitionProposalPetition[]

  @@index([coalitionId])
  @@index([proposedByGroupId])
  @@index([targetGroupId])
  @@index([action])
  @@index([status])
}

model CoalitionProposalPetition {
  id            String   @id @default(cuid())
  proposalId    String
  groupId       String
  petitionId    String   @unique
  role          String   // participant | applicant | departing | remaining_member
  groupSnapshot Json
  createdAt     DateTime @default(now())

  proposal CoalitionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  group    Group             @relation(fields: [groupId], references: [id])

  @@unique([proposalId, groupId])
  @@index([proposalId])
  @@index([groupId])
}

model GroupMembership {
  id                  String              @id @default(cuid())
  accountId           String
  groupId             String
  joinedAt            DateTime            @default(now())
  status              MembershipStatus    @default(active)
  participationStatus ParticipationStatus @default(active)
  lastSeenAt          DateTime?
  applicationNote     String?             // optional note submitted with a pending membership application
  decidedAt           DateTime?           // set when a pending application is approved/declined — drives applicant outcome notifications
  // Per-collective consent to receive free-text "custom" support requests. Membership is already
  // group-scoped, so opting in here applies only to THIS collective (not account-wide). When true,
  // this member is offered custom requests routed to the group. `customAvailability` mirrors
  // ServiceCapability.availability (e.g. { availableNow, preference }).
  customAvailable     Boolean             @default(false)
  customAvailability  Json?

  account                       Account                            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  group                         Group                              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  responsibilityAssignments     ResponsibilityAssignment[]
  governanceSignals             MemberGovernanceSignal[]
  createdPetitions              Petition[]                         @relation("PetitionCreator")
  petitionSupport               PetitionSupport[]
  proposedCategoryDrafts        ContributionCategoryDraft[]
  responsibilityProposalDrafts  ResponsibilityProposalDraft[]
  trustedProviderApplications   TrustedProviderApplication[]
  trustedProviderRevocations    TrustedProviderRevocationRequest[]
  trustedProviderStatuses       TrustedProviderStatus[]
  createdInviteTokens           GroupInviteToken[]
  createdRequestLinks           GroupRequestLink[]

  @@unique([accountId, groupId])
  @@index([accountId])
  @@index([groupId])
  @@index([groupId, participationStatus])
  @@index([accountId, decidedAt])
}

model GroupServiceOffering {
  id                      String   @id @default(cuid())
  groupId                 String
  serviceType             String
  status                  String   @default("active")
  minimumContributorTrust String   @default("lightweight")
  projectId               String?
  createdAt               DateTime @default(now())

  group   Group    @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([groupId, serviceType])
  @@index([groupId])
  @@index([status])
  @@index([projectId])
}

model GroupInviteToken {
  id                    String    @id @default(cuid())
  tokenHash             String    @unique   // SHA-256 of raw token, for lookup + uniqueness
  tokenPreview          String              // first 8 chars of raw token for display after reload
  // The raw token is stored ONLY so any active member can re-copy the full link (feedback #2).
  // This is acceptable BECAUSE these are shareable bearer links meant to be distributed, and
  // revocation (revokedAt) is the kill switch. Do NOT copy this pattern for secrets that are
  // never meant to be shared (session tokens, password-reset tokens) — those must stay hash-only.
  // Nullable: links created before this column existed have null and degrade to preview-only.
  rawToken              String?
  groupId               String
  createdByMembershipId String
  createdAt             DateTime  @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?

  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy GroupMembership @relation(fields: [createdByMembershipId], references: [id])

  @@index([groupId])
}

// Shareable, durable request link (feedback #9): lets a PRIVATE group receive support
// requests via an unlisted link without becoming publicly discoverable. Unlike an invite,
// it never expires — it stays valid until revoked (revocation is the only off-switch).
model GroupRequestLink {
  id                    String    @id @default(cuid())
  tokenHash             String    @unique // SHA-256 of raw token, for lookup + uniqueness
  tokenPreview          String             // first 8 chars of raw token, shown so members know a link is active
  // Raw token stored ONLY for re-copy (feedback #2) — acceptable because this is a shareable
  // bearer link meant to be distributed, with revocation as the kill switch. Never store raw
  // tokens that aren't meant to be shared (session/reset tokens). Nullable for pre-column rows.
  rawToken              String?
  groupId               String
  createdByMembershipId String
  createdAt             DateTime  @default(now())
  revokedAt             DateTime?

  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy GroupMembership @relation(fields: [createdByMembershipId], references: [id])

  @@index([groupId])
}

model Project {
  id                    String        @id @default(cuid())
  foundingGroupId       String        // immutable founding-group provenance; confers no current-hosting authority (see ProjectHosting)
  name                  String
  description           String?
  status                ProjectStatus @default(active)
  membershipPolicy      String        @default("petition") // petition = requires approval workflow
  governancePreferences Json?
  privacyPreferences    Json?
  archivedAt            DateTime?     // visibility flag: archived ≠ closed/completed
  pendingClosureAt      DateTime?     // set when the last active ProjectHosting ends; opens the 30-day adoption grace period (RFC-007)
  pendingClosureElectorate Json?       // immutable ProjectMembership/account snapshot captured with pendingClosureAt
  // Future: archivedBy, archiveProposalId, archiveReason (Governance RFC)
  createdAt             DateTime      @default(now())

  foundingGroup    Group                  @relation(fields: [foundingGroupId], references: [id])
  hostings         ProjectHosting[]
  hostingProposals ProjectHostingProposal[]
  memberships      ProjectMembership[]
  serviceOfferings GroupServiceOffering[]
  supportRequests  SupportRequest[]
  offers           Offer[]
  contributions    Contribution[]
  proposals        Proposal[]
  actionLogs       ActionLog[]
  signedEvents     SignedEvent[]

  @@unique([foundingGroupId, name])
  @@index([foundingGroupId])
  @@index([status])
  @@index([archivedAt])
}

model ProjectHosting {
  id        String    @id @default(cuid())
  projectId String
  groupId   String
  hostedAt  DateTime  @default(now())
  endedAt   DateTime? // null = active hosting; set on withdrawal. Active uniqueness on [projectId, groupId] is enforced by a partial index in migration SQL (Prisma cannot express WHERE-conditioned @@unique)

  project Project @relation(fields: [projectId], references: [id])
  group   Group   @relation(fields: [groupId], references: [id])

  @@index([projectId])
  @@index([groupId])
  @@index([endedAt])
}

model ProjectMembership {
  id                  String              @id @default(cuid())
  accountId           String
  projectId           String
  joinedAt            DateTime            @default(now())
  status              MembershipStatus    @default(active)
  participationStatus ParticipationStatus @default(active)
  lastSeenAt          DateTime?
  applicationNote     String?             // optional note submitted with a pending project join request
  decidedAt           DateTime?           // set when a pending join request is approved/declined — drives applicant outcome notifications

  account          Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdPetitions Petition[]       @relation("PetitionProjectCreator")
  petitionSupport  PetitionSupport[] @relation("PetitionSupportProject")
  contributionCategoryDrafts ContributionCategoryDraft[] @relation("ContributionCategoryDraftProjectProposer")

  @@unique([accountId, projectId])
  @@index([accountId])
  @@index([projectId])
  @@index([projectId, participationStatus])
  @@index([accountId, decidedAt])
}

// RFC-007: links a candidate group's "should we host?" petition with a pending-closure
// project's "should we accept this host?" petition into one mutual-consent bundle.
// Same orchestration shape as CoalitionProposal (Phase 2): immutable snapshots + frozen
// electorate + linked child petitions + resolution state. ProjectHosting is created only
// when both child petitions succeed; either side rejecting, withdrawing, or timing out
// fails the whole proposal and supersedes the other still-open petition.
model ProjectHostingProposal {
  id                     String    @id @default(cuid())
  projectId              String
  candidateGroupId       String
  projectSnapshot        Json      // immutable { id, name } project identity at proposal creation
  candidateGroupSnapshot Json      // immutable { id, name } candidate-group identity at proposal creation
  frozenElectorate       Json      // immutable array of qualifying ProjectMembership ids, captured at Project.pendingClosureAt (RFC-007 pending-closure electorate)
  content                String    // immutable rationale supplied when the proposal was opened
  groupPetitionId        String    @unique // candidate group's "should we host?" petition (Petition.id; loose reference, validated at service layer like Petition.subjectId)
  projectPetitionId      String    @unique // project's "should we accept this host?" petition (Petition.id; loose reference, validated at service layer like Petition.subjectId)
  status                 String    @default("open") // open | succeeded | failed-rejected | failed-withdrawn | failed-timeout
  createdAt              DateTime  @default(now())
  resolvedAt             DateTime?

  project        Project @relation(fields: [projectId], references: [id])
  candidateGroup Group   @relation(fields: [candidateGroupId], references: [id])

  @@index([projectId])
  @@index([candidateGroupId])
  @@index([groupPetitionId])
  @@index([projectPetitionId])
  @@index([status])
}

model ServiceCapability {
  id               String                  @id @default(cuid())
  accountId        String
  serviceType      String
  description      String?
  availability     Json?
  visibility       VisibilityLevel         @default(group)
  trustRequirement TrustRequirement        @default(lightweight)
  approvalStatus   ServiceCapabilityStatus @default(available)
  // Optional link to a community-governed ContributionCategory (RFC: Contribution Categories)
  categoryId       String?
  createdAt        DateTime                @default(now())

  account             Account                    @relation(fields: [accountId], references: [id])
  trustedRecords      TrustedServiceCapability[]
  requestRoutes       RequestRoute[]
  availabilityRecords ContributorAvailability[]
  category            ContributionCategory?      @relation(fields: [categoryId], references: [id])

  @@unique([accountId, serviceType, trustRequirement])
  @@index([accountId])
  @@index([serviceType])
  @@index([approvalStatus])
  @@index([trustRequirement])
  @@index([categoryId])
}

model TrustedServiceCapability {
  id                  String      @id @default(cuid())
  serviceCapabilityId String
  groupId             String
  trustContext        String
  status              TrustStatus @default(petitioned)
  approvedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime    @default(now())

  serviceCapability ServiceCapability @relation(fields: [serviceCapabilityId], references: [id])
  group             Group             @relation(fields: [groupId], references: [id])

  @@unique([serviceCapabilityId, groupId, trustContext])
  @@index([serviceCapabilityId])
  @@index([groupId])
  @@index([status])
}

model SupportRequest {
  id                   String               @id @default(cuid())
  submittedByAccountId String?
  guestRequestId       String?
  groupId              String
  projectId            String?
  requestType          String
  requestedServices    Json
  description          String
  // For custom (free-text) requests: the requester's described need, stored separately from
  // `description` so the need can be shown to potential helpers without exposing the contact
  // note (which lives in `description` and is only revealed after a helper accepts).
  customNeed           String?
  urgency              UrgencyLevel         @default(normal)
  privacyLevel         PrivacyLevel         @default(private)
  status               SupportRequestStatus @default(open)
  expiresAt            DateTime?
  accountabilityEndsAt DateTime?
  createdAt            DateTime             @default(now())

  submittedBy       Account?                @relation(fields: [submittedByAccountId], references: [id])
  group             Group                   @relation(fields: [groupId], references: [id])
  project           Project?                @relation(fields: [projectId], references: [id])
  offers            Offer[]
  services          SupportRequestService[]
  routes            RequestRoute[]
  guestAccessToken  GuestAccessToken?
  flaggedReports    Report[]                @relation("RequestFlag")

  @@index([submittedByAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([status])
  @@index([expiresAt])
  @@index([accountabilityEndsAt])
  @@index([urgency])
}

model GuestAccessToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  supportRequestId String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?

  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  reports        Report[]
}

model SupportRequestService {
  id               String           @id @default(cuid())
  supportRequestId String
  serviceType      String
  trustRequirement TrustRequirement @default(lightweight)
  // Optional link to a community-governed ContributionCategory (RFC: Contribution Categories)
  categoryId       String?
  createdAt        DateTime         @default(now())

  supportRequest SupportRequest        @relation(fields: [supportRequestId], references: [id])
  category       ContributionCategory? @relation(fields: [categoryId], references: [id])

  @@unique([supportRequestId, serviceType, trustRequirement])
  @@index([serviceType])
  @@index([trustRequirement])
  @@index([categoryId])
}

model RequestRoute {
  id                   String             @id @default(cuid())
  supportRequestId     String
  contributorAccountId String
  serviceCapabilityId  String?
  serviceType          String
  trustRequirement     TrustRequirement   @default(lightweight)
  status               RequestRouteStatus @default(notified)
  decisionNote         String?
  decidedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  supportRequest    SupportRequest    @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  contributor       Account           @relation(fields: [contributorAccountId], references: [id], onDelete: Cascade)
  serviceCapability ServiceCapability? @relation(fields: [serviceCapabilityId], references: [id], onDelete: Cascade)

  @@unique([supportRequestId, contributorAccountId, serviceType, trustRequirement])
  @@index([supportRequestId])
  @@index([contributorAccountId])
  @@index([serviceCapabilityId])
  @@index([serviceType])
  @@index([trustRequirement])
  @@index([status])
  @@index([createdAt])
}

model ContributorAvailability {
  id                  String   @id @default(cuid())
  accountId           String
  serviceCapabilityId String?
  serviceType         String
  availability        Json
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  serviceCapability ServiceCapability? @relation(fields: [serviceCapabilityId], references: [id], onDelete: Cascade)

  @@unique([accountId, serviceType])
  @@index([accountId])
  @@index([serviceCapabilityId])
  @@index([serviceType])
  @@index([active])
}

model Offer {

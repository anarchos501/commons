  resolvedAt                    DateTime?

  group     Group    @relation(fields: [groupId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
  createdBy Account  @relation(fields: [createdByAccountId], references: [id])

  @@index([groupId])
  @@index([projectId])
  @@index([createdByAccountId])
  @@index([status])
}

model Report {
  id                  String                @id @default(cuid())
  reportedByAccountId String?
  guestAccessTokenId  String?
  groupId             String
  subject             String
  // Optional structured identity of the member the concern is about. Free-text
  // `subject` remains the narrative; `subjectAccountId` is set only when a specific
  // member is named (null for concerns about non-persons or guest subjects). Used to
  // exclude the subject from reviewing their own concern (RFC-002, no direct involvement).
  subjectAccountId    String?
  context             String?
  description         String
  kind                ReportKind            @default(person_concern)
  // Set for request flags (kind = request_flag): the request the flag is about, so reviewers have
  // the artifact to act on. Null for person concerns. Does NOT imply a subject.
  supportRequestId    String?
  status              ReportStatus          @default(open)
  visibility          String                @default("private")
  closureReason       ConcernClosureReason?
  closedAt            DateTime?
  withdrawnAt         DateTime?
  resolvedAt          DateTime?
  resolvedNote        String?
  createdAt           DateTime              @default(now())

  reportedBy       Account?               @relation("ConcernReporter", fields: [reportedByAccountId], references: [id])
  subjectAccount   Account?               @relation("ConcernSubject", fields: [subjectAccountId], references: [id])
  guestAccessToken GuestAccessToken?      @relation(fields: [guestAccessTokenId], references: [id])
  group            Group                  @relation(fields: [groupId], references: [id])
  supportRequest   SupportRequest?        @relation("RequestFlag", fields: [supportRequestId], references: [id])
  reviews          ConcernReview[]
  findings         ConcernFinding[]
  actionProposals  ConcernActionProposal[]

  @@index([reportedByAccountId])
  @@index([subjectAccountId])
  @@index([guestAccessTokenId])
  @@index([groupId])
  @@index([status])
  @@index([supportRequestId])
}

model ConcernReview {
  id          String    @id @default(cuid())
  reportId    String
  reviewerId  String
  groupId     String
  notes       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  report   Report  @relation(fields: [reportId], references: [id])
  reviewer Account @relation(fields: [reviewerId], references: [id])
  group    Group   @relation(fields: [groupId], references: [id])

  @@index([reportId])
  @@index([reviewerId])
  @@index([groupId])
}

model ConcernFinding {
  id         String                @id @default(cuid())
  reportId   String
  reviewerId String
  groupId    String
  outcome    ConcernFindingOutcome
  summary    String
  createdAt  DateTime              @default(now())

  report   Report  @relation(fields: [reportId], references: [id])
  reviewer Account @relation(fields: [reviewerId], references: [id])
  group    Group   @relation(fields: [groupId], references: [id])

  @@index([reportId])
  @@index([reviewerId])
}

model ConcernActionProposal {
  id             String                @id @default(cuid())
  reportId       String
  proposedById   String
  groupId        String
  proposedAction String
  rationale      String
  iteration      Int                   @default(1)
  // Governance Decision layer connects here — deferred to future governance RFC
  status         ConcernProposalStatus @default(pending)
  createdAt      DateTime              @default(now())

  report     Report  @relation(fields: [reportId], references: [id])
  proposedBy Account @relation(fields: [proposedById], references: [id])
  group      Group   @relation(fields: [groupId], references: [id])

  @@index([reportId])
  @@index([proposedById])
}

model Responsibility {
  // first-class built-in: "reviewer" (platform understands this type)
  // all other values are custom responsibility types created by group governance
  // Custom responsibilities are the expected long-term coordination mechanism;
  // reviewer is first-class only because the accountability system requires
  // platform-level reviewer behavior.
  id        String   @id @default(cuid())
  groupId   String
  type      String
  termDays  Int      @default(365)
  createdAt DateTime @default(now())
  // Polymorphic pointer to the LivingDocument (spaceType: "responsibility", spaceId: this.id,
  // title: "Purpose") that holds this role's editable purpose statement. Not FK-enforced —
  // mirrors the LivingDocument.spaceId convention (see living-documents.ts). Null until a
  // responsibility-creation proposal seeds one; pre-existing/seeded responsibilities stay null
  // until a member proposes a living document for the role through the normal flow.
  descriptionDocumentId String?

  group       Group                     @relation(fields: [groupId], references: [id])
  assignments ResponsibilityAssignment[]
  abilities   ResponsibilityAbility[]

  @@unique([groupId, type])
  @@index([groupId])
  @@index([type])
}

model ResponsibilityAssignment {
  id               String               @id @default(cuid())
  responsibilityId String
  // FK to GroupMembership — responsibilities are group-scoped, not account-scoped.
  // A member can be Active in Group A and Quiet in Group B simultaneously.
  membershipId     String
  startedAt        DateTime             @default(now())
  expiresAt        DateTime             // derived from Responsibility.termDays at assignment time
  endedAt          DateTime?
  endReason        AssignmentEndReason?
  createdAt        DateTime             @default(now())

  responsibility Responsibility  @relation(fields: [responsibilityId], references: [id])
  membership     GroupMembership @relation(fields: [membershipId], references: [id])

  @@index([responsibilityId])
  @@index([membershipId])
  @@index([expiresAt])
}

model ResponsibilityAbility {
  id               String              @id @default(cuid())
  responsibilityId String
  ability          CoordinationAbility
  availability     AbilityAvailability @default(always_available)
  createdAt        DateTime            @default(now())

  responsibility Responsibility @relation(fields: [responsibilityId], references: [id])

  @@unique([responsibilityId, ability])
  @@index([responsibilityId])
}

model ResponsibilityProposalDraft {
  id                      String    @id @default(cuid())
  groupId                 String
  type                    String
  description             String    // seed text for the responsibility's auto-created Purpose living document
  abilities               Json      // [{ ability: CoordinationAbility, availability: AbilityAvailability }]
  proposedByMembershipId  String
  createdAt               DateTime  @default(now())
  appliedAt               DateTime?
  appliedResponsibilityId String?   // the Responsibility this proposal resulted in or was merged into

  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [proposedByMembershipId], references: [id])

  @@index([groupId])
  @@index([proposedByMembershipId])
}

model GovernancePreference {
  id         String               @id @default(cuid())
  key        String
  value      Json
  scope      GovernanceScope
  scopeId    String?
  changeRule GovernanceChangeRule @default(mutable)
  createdBy  String
  createdAt  DateTime             @default(now())

  @@index([scope, scopeId])
  @@index([key])
}

// --- RFC-006: Governance Temperature ---

model MemberGovernanceSignal {
  id           String          @id @default(cuid())
  membershipId String
  groupId      String
  category     String          // GovernanceCategory key, validated at service layer
  parameter    String          @default("_") // "_" = category-level, otherwise a category parameter key
  signal       Int             // constrained to -1 | 0 | +1 at service layer
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([membershipId, category, parameter])
  @@index([groupId, category])
}

// --- RFC-006: Emergency Period ---

model EmergencyPeriod {
  id                 String    @id @default(cuid())
  groupId            String
  petitionId         String?   // null when created via declareTempStewardship (no petition)
  startedAt          DateTime  @default(now())
  expiresAt          DateTime
  endedAt            DateTime?
  endedByPetitionId  String?   // set if ended via deactivation petition

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([expiresAt])
  @@unique([petitionId])
}

// --- RFC-006: Petition Infrastructure ---

model Petition {
  id                           String    @id @default(cuid())
  // Scope fields (P1 migration): scopeType/scopeId replace groupId as the governing-entity reference.
  // groupId kept as nullable for backward compat during transition — prefer scopeId.
  groupId                      String?
  scopeType                    String    @default("group") // "group" | "project" | "responsibility" | "node"
  scopeId                      String    // governing entity id; backfilled from groupId for existing records
  category                     String    // GovernanceCategory, validated at service layer
  subjectType                  String    // ProposalFamily, validated at service layer
  subjectId                    String
  competitionKey               String?   // derived from subjectType+subjectId; null = non-competing
  status                       String    @default("open") // open | approved | rejected | withdrawn | superseded | blocked
  governanceSnapshot           Json      // resolved parameters frozen at petition open time
  // null = group-wide voting; { type: "project", scopeId } = project-member voting
  voterScope                   Json?
  opensAt                      DateTime  @default(now())
  closesAt                     DateTime
  resolvedAt                   DateTime?
  archivedAt                   DateTime? // set lazily ~30 days after resolvedAt by archiveStalePetitions
  createdByMembershipId        String?   // legacy: GroupMembership FK — kept for compat
  createdByProjectMembershipId String?   // new: ProjectMembership FK for project-scoped petitions
  createdByAccountId           String?   // account creator for node-host-origin petitions

  group             Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy         GroupMembership?   @relation("PetitionCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  createdByProject  ProjectMembership? @relation("PetitionProjectCreator", fields: [createdByProjectMembershipId], references: [id], onDelete: SetNull)
  createdByAccount  Account?           @relation("PetitionAccountCreator", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  support           PetitionSupport[]
  nodeSupport       NodePetitionSupport[]

  @@index([scopeType, scopeId, status])
  @@index([groupId, status])
  @@index([groupId, archivedAt])
  @@index([category])
  @@index([competitionKey])
  @@index([subjectType, subjectId])
  @@index([status, closesAt])
}

model NodePetitionSupport {
  id         String   @id @default(cuid())
  petitionId String
  nodeId     String
  accountId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  petition Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  node     Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([petitionId, accountId])
  @@index([nodeId, accountId])
}

model PetitionSupport {
  id                  String   @id @default(cuid())
  petitionId          String
  // P1 migration: membershipId made nullable; projectMembershipId added.
  // Exactly one of membershipId/projectMembershipId must be non-null (service-layer enforced).
  // Partial unique indexes (in migration SQL, not Prisma-managed):
  //   UNIQUE (petitionId, membershipId) WHERE membershipId IS NOT NULL
  //   UNIQUE (petitionId, projectMembershipId) WHERE projectMembershipId IS NOT NULL
  membershipId        String?  // GroupMembership; nullable (was required)
  projectMembershipId String?  // ProjectMembership; null for group-scoped petitions
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  petition          Petition           @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  membership        GroupMembership?   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  projectMembership ProjectMembership? @relation("PetitionSupportProject", fields: [projectMembershipId], references: [id], onDelete: Cascade)

  @@index([petitionId])
}

model PrivacyEnvelope {
  id         String       @id @default(cuid())
  targetType String
  targetId   String
  level      PrivacyLevel @default(private)
  rules      Json?
  createdBy  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([targetType, targetId])
  @@index([level])
}

model ActionLog {
  id             String   @id @default(cuid())
  actorAccountId String?
  groupId        String?
  projectId      String?
  nodeId         String?
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor   Account? @relation(fields: [actorAccountId], references: [id])
  group   Group?   @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  node    Node?    @relation(fields: [nodeId], references: [id])

  @@index([actorAccountId])
  @@index([groupId])
  @@index([projectId])
  @@index([nodeId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SignedEvent {
  id                 String          @id @default(cuid())
  eventType          SignedEventType
  subjectType        String
  subjectId          String
  actorAccountId     String?
  portableIdentityId String?
  nodeId             String?
  groupId            String?
  projectId          String?
  payload            Json
  payloadHash        String
  signature          String
  publicKey          String
  createdAt          DateTime        @default(now())

  actor            Account?          @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  portableIdentity PortableIdentity? @relation(fields: [portableIdentityId], references: [id], onDelete: SetNull)
  node             Node?             @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  group            Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([payloadHash, signature])
  @@index([eventType])
  @@index([subjectType, subjectId])
  @@index([actorAccountId])
  @@index([portableIdentityId])
  @@index([nodeId])
  @@index([groupId])
  @@index([projectId])
  @@index([createdAt])
}

model LocalSyncState {
  id               String    @id @default(cuid())
  accountId        String
  deviceId         String
  lastAckedEventId String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceId])
  @@index([lastAckedEventId])
  @@index([lastSyncedAt])
}

model DataReplicationPolicy {
  id                  String             @id @default(cuid())
  scope               GovernanceScope
  scopeId             String
  dataClass           DataClass
  nodeStorage         NodeStoragePolicy
  localStorage        LocalStoragePolicy
  federationAllowed   Boolean            @default(false)
  p2pAllowed          Boolean            @default(false)
  retentionDays       Int?
  requiresEncryption  Boolean            @default(true)
  userExportAllowed   Boolean            @default(true)
  userDeletionAllowed Boolean            @default(true)
  syncRequiresConsent Boolean            @default(true)
  createdAt           DateTime           @default(now())

  @@unique([scope, scopeId, dataClass])
  @@index([dataClass])
  @@index([scope, scopeId])
  @@index([federationAllowed])
  @@index([p2pAllowed])
}

// --- D3: Communication Schema ---
// All communication models use { spaceType, spaceId } to target any Coordination Space
// (Group, Project, or Responsibility) without table-per-type duplication.

model Bulletin {
  id                String                @id @default(cuid())
  spaceType         CoordinationSpaceType
  spaceId           String
  authorId          String
  title             String
  body              String
  publishedAt       DateTime              @default(now())
  archivedAt        DateTime?
  archivedByAccountId String?
  archiveProposalId String?
  archiveReason     String?
  createdAt         DateTime              @default(now())

  author Account @relation(fields: [authorId], references: [id])

  @@index([spaceType, spaceId])
  @@index([authorId])
  @@index([archivedAt])
}

model Publication {
  id                  String                @id @default(cuid())
  spaceType           CoordinationSpaceType
  spaceId             String
  title               String
  createdByAccountId  String
  archivedAt          DateTime?
  archivedByAccountId String?
  archiveProposalId   String?
  archiveReason       String?
  createdAt           DateTime              @default(now())

  creator Account          @relation(fields: [createdByAccountId], references: [id])
  entries PublicationEntry[]

  @@index([spaceType, spaceId])
  @@index([createdByAccountId])
  @@index([archivedAt])
}

model PublicationEntry {
  id                  String    @id @default(cuid())
  publicationId       String
  authorId            String
  title               String?
  body                String
  publishedAt         DateTime  @default(now())
  archivedAt          DateTime?
  archivedByAccountId String?
  archiveProposalId   String?
  archiveReason       String?

  publication Publication @relation(fields: [publicationId], references: [id])
  author      Account     @relation(fields: [authorId], references: [id])

  @@index([publicationId])
  @@index([authorId])
  @@index([archivedAt])
}

model LivingDocument {
  id                  String                @id @default(cuid())
  spaceType           CoordinationSpaceType
  spaceId             String
  title               String
  currentBody         String
  // currentBody is always the current accepted version.
  // LivingDocument identity persists across revisions: revisions create
  // LivingDocumentRevision records, never a new LivingDocument.
  lastRevisedAt       DateTime              @default(now())
  archivedAt          DateTime?
  archivedByAccountId String?
  archiveProposalId   String?
  archiveReason       String?
  createdAt           DateTime              @default(now())

  revisions LivingDocumentRevision[]

  @@unique([spaceType, spaceId, title])
  @@index([spaceType, spaceId])
  @@index([archivedAt])
}

model LivingDocumentRevision {
  id                   String    @id @default(cuid())
  livingDocumentId     String
  authorId             String
  body                 String
  proposalId           String?   // FK to Petition.id (set on approval)
  approvedAt           DateTime?
  approvedByAccountId  String?
  createdAt            DateTime  @default(now())

  livingDocument LivingDocument @relation(fields: [livingDocumentId], references: [id])
  author         Account        @relation(fields: [authorId], references: [id])

  @@index([livingDocumentId])
  @@index([authorId])
}

model DiscussionThread {
  id                  String                @id @default(cuid())
  spaceType           CoordinationSpaceType
  spaceId             String
  title               String
  createdByAccountId  String
  lastActivityAt      DateTime              @default(now())
  messageCount        Int                   @default(0)
  closedAt            DateTime?
  closedByPetitionId  String?
  closureReason       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  creator  Account                @relation(fields: [createdByAccountId], references: [id])
  messages DiscussionMessage[]
  reads    DiscussionThreadRead[]

  @@index([spaceType, spaceId])
  @@index([createdByAccountId])
  @@index([lastActivityAt])
  @@index([closedAt])
}

model DiscussionMessage {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author Account          @relation(fields: [authorId], references: [id])

  @@index([threadId])
  @@index([authorId])
  @@index([expiresAt])
  @@index([createdAt])
}

// Per-account read watermark for discussion threads (feedback #10). PRIVACY BOUNDARY: like
// GroupMembership.lastSeenAt, this is a private relational/temporal fact used only to render
// the OWNING account's view ("New" badge on threads, brighter unread bubbles). It must never
// be surfaced to other members (no "X has read this", no read receipts to authors) and never
// aggregated into counts or engagement data — the badge is "New", not "7 unread".
model DiscussionThreadRead {
  id         String   @id @default(cuid())
  accountId  String
  threadId   String
  lastReadAt DateTime @default(now())

  account Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  thread  DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([accountId, threadId])
  @@index([threadId])
}

// --- RFC: Contribution Categories & Trusted Provider Status ---

model ContributionCategoryDraft {
  id                     String             @id @default(cuid())
  groupId                String
  offeringEntityType     OfferingEntityType
  offeringEntityId       String
  name                   String
  description            String
  proposedByMembershipId String?
  proposedByProjectMembershipId String?
  createdAt              DateTime           @default(now())

  group             Group              @relation(fields: [groupId], references: [id])
  membership        GroupMembership?   @relation(fields: [proposedByMembershipId], references: [id])
  projectMembership ProjectMembership? @relation("ContributionCategoryDraftProjectProposer", fields: [proposedByProjectMembershipId], references: [id])

  @@index([groupId])
  @@index([proposedByMembershipId])
  @@index([proposedByProjectMembershipId])
}

model ContributionCategory {
  id                 String             @id @default(cuid())
  groupId            String             // governance anchor — always a Group ID
  offeringEntityType OfferingEntityType
  offeringEntityId   String             // ID of the offering group/project/responsibility
  name               String
  description        String
  status             CategoryStatus     @default(active)
  createdAt          DateTime           @default(now())
  archivedAt         DateTime?

  group               Group                  @relation(fields: [groupId], references: [id])
  trustedProviders    TrustedProviderStatus[]
  serviceCapabilities ServiceCapability[]
  requestServices     SupportRequestService[]

  @@unique([offeringEntityType, offeringEntityId, name])
  @@index([groupId])
  @@index([offeringEntityType, offeringEntityId])
  @@index([status])
}

model TrustedProviderApplication {
  id           String   @id @default(cuid())
  membershipId String   // the member being trusted
  groupId      String
  categoryIds  Json     // String[] — IDs of ContributionCategory records
  requestedAt  DateTime @default(now())

  membership GroupMembership @relation(fields: [membershipId], references: [id])
  group      Group           @relation(fields: [groupId], references: [id])

  @@index([membershipId])
  @@index([groupId])
}

model TrustedProviderRevocationRequest {
  id                 String   @id @default(cuid())
  targetMembershipId String
  groupId            String
  statusIds          Json     // String[] — IDs of TrustedProviderStatus records to revoke
  requestedAt        DateTime @default(now())

  membership GroupMembership @relation(fields: [targetMembershipId], references: [id])
  group      Group           @relation(fields: [groupId], references: [id])

  @@index([targetMembershipId])
  @@index([groupId])
}

model TrustedProviderStatus {
  id           String                     @id @default(cuid())
  membershipId String
  categoryId   String
  groupId      String
  status       TrustedProviderStatusValue @default(active)
  grantedAt    DateTime                   @default(now())
  revokedAt    DateTime?

  membership GroupMembership      @relation(fields: [membershipId], references: [id])
  category   ContributionCategory @relation(fields: [categoryId], references: [id])
  group      Group                @relation(fields: [groupId], references: [id])

  @@unique([membershipId, categoryId])
  @@index([membershipId])
  @@index([categoryId])
  @@index([groupId])
  @@index([status])
}

model ContentCreationDraft {
  id                           String                @id @default(cuid())
  contentType                  ContentCreationType
  groupId                      String
  spaceType                    CoordinationSpaceType
  spaceId                      String
  publicationId                String?
  authorAccountId              String
  createdByMembershipId        String?
  createdByProjectMembershipId String?
  title                        String?
  body                         String?
  createdAt                    DateTime              @default(now())
  // Data-minimization: unapplied drafts whose petition has resolved are swept after this time
  // (expireStaleContentDrafts), mirroring the expire+sweep pattern used for petitions, invites,
  // discussions, and assignments. Nullable for rows created before this field existed.
  expiresAt                    DateTime?
  appliedAt                    DateTime?
  createdContentId             String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([appliedAt])
  @@index([expiresAt])
}

// ── RFC-008: Coordination Events & Shared Calendars ───────────────────────────

// Canonical event row. hostId / EventAudience.audienceId are polymorphic and not
// FK-enforced (same convention as Bulletin.spaceId); validated in the service layer.
model CalendarEvent {
  id                    String          @id @default(cuid())
  category              EventCategory
  hostType              EventHostType
  hostId                String          // group/project/responsibility/coalition id, or accountId (personal)
  title                 String
  description           String?
  startTime             DateTime        // stored UTC
  endTime               DateTime        // stored UTC
  timezone              String          // IANA id for display
  location              String?
  visibility            EventVisibility @default(host_only)
  createdByAccountId    String
  authorizingPetitionId String?         // set for petitioned events; null for direct workshops/personal
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  canceledAt            DateTime?
  canceledByAccountId   String?
  cancelReason          String?

  createdBy Account         @relation("CalendarEventCreator", fields: [createdByAccountId], references: [id])
  audiences EventAudience[]
  interests EventInterest[]

  @@index([hostType, hostId])
  @@index([startTime])
  @@index([canceledAt])
}

// Additional target spaces (other than the host) the event is broadcast to.
// Empty = internal event. A non-empty audience on a space-hosted event triggers
// the authorization requirement (see eventRequiresAuthorization in events.ts).
model EventAudience {
  id           String        @id @default(cuid())
  eventId      String
  audienceType EventHostType  // group|project|responsibility|coalition (account is never an audience)
  audienceId   String
  createdAt    DateTime      @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, audienceType, audienceId])
  @@index([audienceType, audienceId])
}

// Lightweight planning signal. accountId is stored to enforce one-response-per-account
// and allow self-withdraw, but is NEVER surfaced — only aggregate counts are read.
model EventInterest {
  id        String             @id @default(cuid())
  eventId   String
  accountId String
  level     EventInterestLevel
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  account Account       @relation("EventInterestAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([eventId, accountId])
  @@index([eventId, level])
}

// Per-account dashboard calendar filter preferences.
model CalendarFilterPreference {
  id                       String   @id @default(cuid())
  accountId                String   @unique
  showGroupEvents          Boolean  @default(true)
  showProjectEvents        Boolean  @default(true)
  showResponsibilityEvents Boolean  @default(true)
  showCoalitionEvents      Boolean  @default(true)
  showPersonalEvents       Boolean  @default(true)
  spaceFilters             Json?    // optional per-space allowlist; validated in service layer
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  account Account @relation("CalendarFilterPrefs", fields: [accountId], references: [id], onDelete: Cascade)
}

// Per-account notification settings + read-state watermarks. One row per account (like
// CalendarFilterPreference). Broadcast categories are muteable via enable* flags + mutedSpaces;
// the person-targeting "About you" class has NO enable flag and ignores mutedSpaces (non-muteable).
// Watermarks give per-category "N new" + "mark read" without per-event rows (store-less-data).
model NotificationPreference {
  id              String    @id @default(cuid())
  accountId       String    @unique
  enableRequests  Boolean   @default(true)
  enablePetitions Boolean   @default(true)
  enableOutcomes  Boolean   @default(true)
  enableSafety    Boolean   @default(true)
  enableUpdates   Boolean   @default(true)
  rollUpUpdates   Boolean   @default(true)
  mutedSpaces     Json?     // { group: [...], project: [...], responsibility: [...], coalition: [...] }
  outcomesSeenAt  DateTime?
  safetySeenAt    DateTime?
  updatesSeenAt   DateTime?
  aboutYouSeenAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account Account @relation("NotificationPrefs", fields: [accountId], references: [id], onDelete: Cascade)
}

// Per-account progressive-disclosure switches for capability cards within a space. `revealAll`
// is the master "reveal everything" toggle; `overrides` is a per-scope show/hide map keyed by
// "global" + "<groupId>", values per moduleId. Defaults (no row) = automatic foreground behavior.
// The system never hides the doors to power — only the user can, and a hidden card always stays
// listed in the RoomsMap (one switch from returning).
model UiDisclosurePreference {
  id        String   @id @default(cuid())
  accountId String   @unique
  revealAll Boolean  @default(false)
  overrides Json?    // { "global": { "<moduleId>": "show"|"hide" }, "<groupId>": { "<moduleId>": "show"|"hide" } }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation("UiDisclosurePrefs", fields: [accountId], references: [id], onDelete: Cascade)
}

// An event awaiting collective authorization (Meeting, or cross-space Workshop).
// Mirrors CoalitionProposal: one child petition per governing group (one for
// group/project/responsibility hosts; one per active member group for coalitions).
model EventProposal {
  id                  String          @id @default(cuid())
  category            EventCategory
  hostType            EventHostType   // service rejects "account"
  hostId              String
  title               String
  description         String?
  startTime           DateTime
  endTime             DateTime
  timezone            String
  location            String?
  visibility          EventVisibility @default(host_only)
  audienceJson        Json            // [{audienceType, audienceId}] applied to EventAudience on approval
  proposedByAccountId String
  status              String          @default("open") // open | succeeded | failed-rejected | failed-withdrawn | failed-timeout
  participantSnapshot Json?           // coalition only: frozen active member-group ids at proposal time
  createdAt           DateTime        @default(now())
  resolvedAt          DateTime?
  appliedAt           DateTime?       // idempotency guard
  createdEventId      String?

  petitions EventProposalPetition[]

  @@index([hostType, hostId])
  @@index([status])
}

model EventProposalPetition {
  id         String   @id @default(cuid())
  proposalId String
  petitionId String   @unique
  groupId    String   // governing group whose electorate voted this petition
  createdAt  DateTime @default(now())

  proposal EventProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

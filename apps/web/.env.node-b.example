# Second-node environment for the two-node federation dev harness.
# Copy to .env.node-b, then:
#   pnpm db:setup:node-b     # creates the commons_node_b database
#   pnpm db:migrate:node-b   # applies migrations to it
#   pnpm dev:node-b          # starts the second instance on port 3001
# See docs/local-environment.md ("Two-node federation harness").
#
# Same Postgres server as node A, different database. Adjust host/credentials
# to match your DATABASE_URL in .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/commons_node_b"
SESSION_SECRET="generate-a-different-random-string-of-at-least-32-characters"
FEEDBACK_FINGERPRINT_SECRET="generate-a-separate-random-string"
